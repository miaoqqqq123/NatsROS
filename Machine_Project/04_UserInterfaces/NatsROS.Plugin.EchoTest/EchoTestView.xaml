<UserControl
    x:Class="NatsROS.Plugin.EchoTest.EchoTestView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
    Background="#1E1E1E">

    <Grid Margin="20">
        <dxlc:LayoutGroup
            Header="🧪 外部动态插件生存测试"
            Orientation="Vertical"
            View="GroupBox">
            <TextBlock
                Margin="0,0,0,20"
                FontSize="16"
                Foreground="LimeGreen"
                Text="这个界面是由一个完全独立的外部 DLL 动态渲染出来的！" />
            <dxlc:LayoutGroup Height="40" Orientation="Horizontal">
                <dxe:TextEdit
                    x:Name="TxtMessage"
                    Width="300"
                    FontSize="16"
                    NullText="输入测试文本..." />
                <dx:SimpleButton
                    Width="150"
                    Margin="10,0,0,0"
                    Background="#00BCD4"
                    Click="BtnBroadcast_Click"
                    Content="📢 向全网广播 (Publish)"
                    FontWeight="Bold"
                    Foreground="Black" />
            </dxlc:LayoutGroup>
        </dxlc:LayoutGroup>
    </Grid>
</UserControl>