<UserControl
    x:Class="ScrewMachine.Dashboard.Plugins.PointStudio.PointStudioView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
    xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    Background="Transparent">

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  顶层统一工具栏 (BarManager)  -->
        <dxb:BarManager Grid.Row="0">
            <dxb:BarManager.Bars>
                <dxb:Bar
                    AllowCustomizationMenu="False"
                    AllowQuickCustomization="False"
                    AllowRemove="False"
                    BorderThickness="5,5,5,0"
                    Caption="示教操作工具栏"
                    CornerRadius="5,5,5,5"
                    GlyphSize="Large"
                    ShowDragWidget="False"
                    ShowSizeGrip="False">
                    <dxb:Bar.ItemLinks>
                        <dxb:BarEditItemLink BarItemName="EditContext" />
                        <dxb:BarEditItemLink BarItemName="EditRecipe" />
                        <dxb:BarItemLinkSeparator />
                        <dxb:BarButtonItemLink BarItemName="BtnRefresh" />
                        <dxb:BarButtonItemLink BarItemName="BtnSavePoints" />
                        <dxb:BarStaticItemLink BarItemName="TxtLockWarning" />
                    </dxb:Bar.ItemLinks>
                </dxb:Bar>
            </dxb:BarManager.Bars>

            <dxb:BarManager.Items>
                <!--  工作域下拉框  -->
                <dxb:BarEditItem
                    x:Name="EditContext"
                    Content="编辑域:"
                    EditValueChanged="EditContext_EditValueChanged"
                    EditWidth="120">
                    <dxb:BarEditItem.EditSettings>
                        <dxe:ComboBoxEditSettings IsTextEditable="False">
                            <dxe:ComboBoxEditSettings.Items>
                                <system:String>⚙️ 机器全局</system:String>
                                <system:String>📦 产品配方</system:String>
                            </dxe:ComboBoxEditSettings.Items>
                        </dxe:ComboBoxEditSettings>
                    </dxb:BarEditItem.EditSettings>
                </dxb:BarEditItem>

                <!--  目标配方下拉框  -->
                <dxb:BarEditItem
                    x:Name="EditRecipe"
                    Content="目标配方:"
                    EditValueChanged="EditRecipe_EditValueChanged"
                    EditWidth="180"
                    IsEnabled="False">
                    <dxb:BarEditItem.EditSettings>
                        <dxe:ComboBoxEditSettings
                            DisplayMember="RecipeName"
                            IsTextEditable="False"
                            NullText="选择草稿配方" />
                    </dxb:BarEditItem.EditSettings>
                </dxb:BarEditItem>

                <!--  操作按钮  -->
                <dxb:BarButtonItem
                    x:Name="BtnRefresh"
                    BarItemDisplayMode="ContentAndGlyph"
                    Content="刷新数据"
                    Glyph="{dx:DXImage 'SvgImages/Icon Builder/Actions_Refresh.svg'}"
                    ItemClick="BtnRefresh_ItemClick" />
                <dxb:BarButtonItem
                    x:Name="BtnSavePoints"
                    BarItemDisplayMode="ContentAndGlyph"
                    Content="💾 保存当前域的所有数据"
                    Foreground="DarkGreen"
                    Glyph="{dx:DXImage 'SvgImages/Save/Save.svg'}"
                    ItemClick="BtnSavePoints_ItemClick" />

                <dxb:BarStaticItem
                    x:Name="TxtLockWarning"
                    Content="⚠️ 当前配方已锁定，禁止示教与保存！"
                    IsVisible="False">
                    <!--  使用 ContentTemplate 定义文本的具体显示样式  -->
                    <dxb:BarStaticItem.ContentTemplate>
                        <DataTemplate>
                            <!--  {Binding} 会自动绑定到上面的 Content 属性值  -->
                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="Bold"
                                Foreground="#FFC62828"
                                Text="{Binding}" />
                        </DataTemplate>
                    </dxb:BarStaticItem.ContentTemplate>
                </dxb:BarStaticItem>
            </dxb:BarManager.Items>
        </dxb:BarManager>

        <!--  全局统一 DockLayoutManager 布局  -->
        <Grid Grid.Row="1" Margin="4">
            <dxdo:DockLayoutManager>
                <dxdo:LayoutGroup Orientation="Horizontal">

                    <!--  1. 左侧：资源分类导航 (Navigation)  -->
                    <dxdo:LayoutPanel
                        AllowClose="False"
                        Caption="🗂️ 点位集合导航"
                        ShowCloseButton="False"
                        ShowPinButton="False">
                        <Grid Margin="5">
                            <!--  【修改1】：彻底删掉了上方占地方的 StackPanel 全局按钮组  -->
                            <dxg:GridControl
                                x:Name="GridNav"
                                Grid.Row="1"
                                AutoGenerateColumns="None"
                                SelectedItemChanged="GridNav_SelectedItemChanged">
                                <dxg:GridControl.View>
                                    <!--  隐藏表头，做成纯粹的导航列表风格  -->
                                    <dxg:TableView
                                        AllowEditing="False"
                                        NavigationStyle="Row"
                                        ShowColumnHeaders="False"
                                        ShowGroupPanel="False"
                                        ShowIndicator="False" />
                                </dxg:GridControl.View>

                                <!--  【组头模板】：保留绿色的 ➕ 号  -->
                                <dxg:GridColumn FieldName="GroupCategory" GroupIndex="0">
                                    <dxg:GridColumn.GroupValueTemplate>
                                        <DataTemplate>
                                            <StackPanel
                                                Margin="5,2,0,2"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="13"
                                                    FontWeight="Bold"
                                                    Foreground="#B0BEC5"
                                                    Text="{Binding Value}" />

                                                <!--  只有当组名是轨迹库时，才显示这个内联新增按钮！  -->
                                                <dx:SimpleButton
                                                    Margin="10,0,0,0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="BtnInlineAddTraj_Click"
                                                    Content="➕"
                                                    Cursor="Hand"
                                                    Foreground="#4CAF50"
                                                    ToolTip="新增一条连续轨迹">
                                                    <dx:SimpleButton.Style>
                                                        <Style TargetType="dx:SimpleButton">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Value}" Value="〽️ 连续轨迹库 (Trajectories)">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </dx:SimpleButton.Style>
                                                </dx:SimpleButton>
                                            </StackPanel>
                                        </DataTemplate>
                                    </dxg:GridColumn.GroupValueTemplate>
                                </dxg:GridColumn>

                                <!--  【数据列 1】：纯粹的名字展示列，占据剩余所有宽度 (*)  -->
                                <dxg:GridColumn Width="*" FieldName="DisplayName">
                                    <dxg:GridColumn.CellStyle>
                                        <Style TargetType="dxg:LightweightCellEditor">
                                            <Setter Property="TextElement.FontWeight" Value="Bold" />
                                            <Setter Property="TextElement.Foreground" Value="#00BCD4" />
                                        </Style>
                                    </dxg:GridColumn.CellStyle>
                                </dxg:GridColumn>

                                <!--  【数据列 2 (新增)】：专属操作列，固定宽度，按钮绝对对齐！  -->
                                <dxg:GridColumn
                                    Width="35"
                                    AllowEditing="False"
                                    FixedWidth="True"
                                    HorizontalHeaderContentAlignment="Center">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <!--  红色删除按钮居中对齐  -->
                                            <dx:SimpleButton
                                                HorizontalAlignment="Center"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="BtnInlineDelTraj_Click"
                                                Content="❌"
                                                Cursor="Hand"
                                                Foreground="DarkRed"
                                                Tag="{Binding RowData.Row}"
                                                ToolTip="删除该轨迹">
                                                <dx:SimpleButton.Style>
                                                    <Style TargetType="dx:SimpleButton">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <!--  依然是只有轨迹才显示删除按钮  -->
                                                            <DataTrigger Binding="{Binding RowData.Row.Type}" Value="Trajectory">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </dx:SimpleButton.Style>
                                            </dx:SimpleButton>
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>

                            </dxg:GridControl>
                        </Grid>
                    </dxdo:LayoutPanel>

                    <!--  2. 中间：扁平化核心数据表 (Excel 风格)  -->
                    <dxdo:LayoutPanel
                        x:Name="GrpData"
                        AllowClose="False"
                        Caption="📝 数据明细表"
                        ItemWidth="2*"
                        ShowCloseButton="False"
                        ShowPinButton="False">
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--  单点集合的工具栏  -->
                            <StackPanel
                                x:Name="ToolBarSingle"
                                Grid.Row="0"
                                Margin="0,0,0,10"
                                Orientation="Horizontal"
                                Visibility="Visible">
                                <dx:SimpleButton
                                    Width="150"
                                    Height="30"
                                    Background="#FF00838F"
                                    Click="BtnAddSinglePoint_Click"
                                    Content="➕ 新增单点 (Add Point)"
                                    FontWeight="Bold"
                                    Foreground="White" />
                            </StackPanel>

                            <!--  轨迹集合的工具栏  -->
                            <StackPanel
                                x:Name="ToolBarTraj"
                                Grid.Row="0"
                                Margin="0,0,0,10"
                                Orientation="Horizontal"
                                Visibility="Collapsed">
                                <TextBlock
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Foreground="Gray"
                                    Text="轨迹名称:" />
                                <dxe:TextEdit
                                    x:Name="TxtTrajName"
                                    Width="150"
                                    EditValueChanged="TxtTrajName_EditValueChanged"
                                    FontWeight="Bold" />
                                <dx:SimpleButton
                                    Width="180"
                                    Height="30"
                                    Margin="20,0,0,0"
                                    Background="#FF00838F"
                                    Click="BtnAppendTrajNode_Click"
                                    Content="➕ 追加路径点 (Append Node)"
                                    FontWeight="Bold"
                                    Foreground="White" />
                            </StackPanel>

                            <!--  动态网格，根据选中状态切换列！  -->
                            <dxg:GridControl
                                x:Name="GridData"
                                Grid.Row="1"
                                AutoGenerateColumns="None">
                                <dxg:GridControl.View>
                                    <dxg:TableView
                                        AllowEditing="True"
                                        EditorShowMode="MouseDown"
                                        EnableImmediatePosting="True"
                                        NavigationStyle="Cell"
                                        ShowGroupPanel="False" />
                                </dxg:GridControl.View>

                                <dxg:GridColumn
                                    x:Name="ColName"
                                    Width="150"
                                    FieldName="Name"
                                    Header="点位名称" />
                                <dxg:GridColumn
                                    Width="80"
                                    FieldName="X"
                                    Header="X (mm)" />
                                <dxg:GridColumn
                                    Width="80"
                                    FieldName="Y"
                                    Header="Y (mm)" />
                                <dxg:GridColumn
                                    Width="80"
                                    FieldName="Z"
                                    Header="Z (mm)" />
                                <dxg:GridColumn
                                    Width="70"
                                    FieldName="Speed"
                                    Header="速度" />
                                <dxg:GridColumn
                                    x:Name="ColDispense"
                                    Width="70"
                                    FieldName="IsDispense"
                                    Header="是否吐胶"
                                    Visible="False">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:CheckEditSettings />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>

                                <!--  极其硬核的行内操作列 (Inline Actions)  -->
                                <dxg:GridColumn
                                    Width="300"
                                    AllowEditing="False"
                                    Header="快捷操作 (Actions)">
                                    <dxg:GridColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition />
                                                    <ColumnDefinition />
                                                </Grid.ColumnDefinitions>
                                                <dx:SimpleButton
                                                    Grid.Column="0"
                                                    Height="24"
                                                    Margin="5,3,5,3"
                                                    Padding="8,0"
                                                    Background="#FFC62828"
                                                    Click="BtnInlineTeach_Click"
                                                    Content="📍 示教"
                                                    FontWeight="Bold"
                                                    Foreground="White"
                                                    Tag="{Binding RowData.Row}" />
                                                <dx:SimpleButton
                                                    Grid.Column="1"
                                                    Height="24"
                                                    Margin="5,3,6,3"
                                                    Padding="8,0"
                                                    Background="#FF1976D2"
                                                    Click="BtnInlineMove_Click"
                                                    Content="🚗 移动"
                                                    Foreground="White"
                                                    Tag="{Binding RowData.Row}" />
                                                <dx:SimpleButton
                                                    Grid.Column="2"
                                                    Height="24"
                                                    Margin="5,3,5,3"
                                                    Padding="5,0"
                                                    Click="BtnInlineDel_Click"
                                                    Content="❌ 删"
                                                    Foreground="Red"
                                                    Tag="{Binding RowData.Row}" />
                                            </Grid>
                                        </DataTemplate>
                                    </dxg:GridColumn.CellTemplate>
                                </dxg:GridColumn>
                            </dxg:GridControl>
                        </Grid>
                    </dxdo:LayoutPanel>

                    <!--  3. 右侧：JOG 遥控与实况  -->
                    <dxdo:LayoutPanel
                        AllowClose="False"
                        Caption="🎮 遥控与实况 (Control &amp; JOG)"
                        ShowCloseButton="False"
                        ShowPinButton="False">
                        <dxlc:LayoutControl Padding="5">
                            <dxlc:LayoutGroup Orientation="Vertical">
                                <dxlc:LayoutGroup
                                    Height="100"
                                    Header="👁️ 实时机械绝对坐标 (Live Pos)"
                                    View="GroupBox">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel
                                            Grid.Column="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                Foreground="Gray"
                                                Text="X 轴" />
                                            <TextBlock
                                                x:Name="TxtLiveX"
                                                FontSize="24"
                                                FontWeight="Bold"
                                                Foreground="#00BCD4"
                                                Text="0.00" />
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Column="1"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                Foreground="Gray"
                                                Text="Y 轴 (当前站)" />
                                            <TextBlock
                                                x:Name="TxtLiveY"
                                                FontSize="24"
                                                FontWeight="Bold"
                                                Foreground="#4CAF50"
                                                Text="0.00" />
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Column="2"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                Foreground="Gray"
                                                Text="Z 轴" />
                                            <TextBlock
                                                x:Name="TxtLiveZ"
                                                FontSize="24"
                                                FontWeight="Bold"
                                                Foreground="#FF9800"
                                                Text="50.00" />
                                        </StackPanel>
                                    </Grid>
                                </dxlc:LayoutGroup>

                                <dxlc:LayoutGroup
                                    Height="220"
                                    Margin="0,10,0,0"
                                    Header="🎮 JOG 微调遥控器"
                                    View="GroupBox">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <StackPanel
                                            Grid.Row="0"
                                            Margin="0,0,0,15"
                                            HorizontalAlignment="Center"
                                            Orientation="Horizontal">
                                            <TextBlock
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center"
                                                Foreground="LightGray"
                                                Text="步长 (Step):" />
                                            <dxe:ComboBoxEdit
                                                x:Name="CboStep"
                                                Width="80"
                                                IsTextEditable="False"
                                                SelectedIndex="1">
                                                <dxe:ComboBoxEditItem Content="0.1" />
                                                <dxe:ComboBoxEditItem Content="1.0" />
                                                <dxe:ComboBoxEditItem Content="10.0" />
                                                <dxe:ComboBoxEditItem Content="50.0" />
                                            </dxe:ComboBoxEdit>
                                            <TextBlock
                                                Margin="5,0,20,0"
                                                VerticalAlignment="Center"
                                                Foreground="Gray"
                                                Text="mm" />

                                            <TextBlock
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center"
                                                Foreground="LightGray"
                                                Text="当前联动平台:" />
                                            <dxe:ComboBoxEdit
                                                x:Name="CboActiveY"
                                                Width="60"
                                                IsTextEditable="False"
                                                SelectedIndex="0">
                                                <dxe:ComboBoxEditItem Content="Y1" />
                                                <dxe:ComboBoxEditItem Content="Y2" />
                                            </dxe:ComboBoxEdit>
                                        </StackPanel>

                                        <!--  十字方向键布局  -->
                                        <Grid
                                            Grid.Row="1"
                                            Width="300"
                                            HorizontalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <dx:SimpleButton
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Margin="2"
                                                Background="#2E7D32"
                                                Click="BtnJog_Click"
                                                Content="Y +"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                Tag="Y+" />
                                            <dx:SimpleButton
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Margin="2"
                                                Background="#0277BD"
                                                Click="BtnJog_Click"
                                                Content="X -"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                Tag="X-" />
                                            <dx:SimpleButton
                                                Grid.Row="1"
                                                Grid.Column="2"
                                                Margin="2"
                                                Background="#0277BD"
                                                Click="BtnJog_Click"
                                                Content="X +"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                Tag="X+" />
                                            <dx:SimpleButton
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                Margin="2"
                                                Background="#2E7D32"
                                                Click="BtnJog_Click"
                                                Content="Y -"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                Tag="Y-" />

                                            <dx:SimpleButton
                                                Grid.Row="0"
                                                Grid.Column="4"
                                                Margin="2"
                                                Background="#EF6C00"
                                                Click="BtnJog_Click"
                                                Content="Z +"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                Tag="Z+" />
                                            <dx:SimpleButton
                                                Grid.Row="2"
                                                Grid.Column="4"
                                                Margin="2"
                                                Background="#EF6C00"
                                                Click="BtnJog_Click"
                                                Content="Z -"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                Tag="Z-" />
                                        </Grid>
                                    </Grid>
                                </dxlc:LayoutGroup>
                            </dxlc:LayoutGroup>
                        </dxlc:LayoutControl>
                    </dxdo:LayoutPanel>

                </dxdo:LayoutGroup>
            </dxdo:DockLayoutManager>
        </Grid>
    </Grid>
</UserControl>