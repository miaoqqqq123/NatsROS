<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- 📦 企业级 NuGet 打包配置 -->
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageId>Hexiv.NatsROS.Core</PackageId>
		<Authors>Hexiv Platform Team</Authors>
		<Company>Hexiv Automation</Company>
		
		<Description>NatsROS 核心通信引擎。基于 NATS.Net 和 MessagePack，提供工业级的高性能 Pub/Sub、RPC 和分布式生命周期管理。</Description>
		<AssemblyVersion>1.2026.0922.0</AssemblyVersion>
		<FileVersion>1.2026.0922.0</FileVersion>
		<PlatformTarget>x64</PlatformTarget>
		<!-- 让 NuGet 版本号动态绑定上面的 FileVersion！ -->
		<Version>2.1.0</Version>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="MessagePack" Version="3.1.8" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
		<PackageReference Include="NATS.Net" Version="2.7.3" />
	</ItemGroup>

</Project>
