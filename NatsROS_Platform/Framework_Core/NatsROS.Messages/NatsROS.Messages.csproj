<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- 📦 企业级 NuGet 打包配置 -->
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageId>Hexiv.NatsROS.Messages</PackageId>
		<Authors>Hexiv Platform Team</Authors>
		<Company>Hexiv Automation</Company>
		
		<Description>NatsROS 底层契约库。包含标准的话题 (Topic)、服务 (Service) 和动作 (Action) 数据模型。</Description>
		<RepositoryUrl>https://your-internal-git-repo/natsros</RepositoryUrl>
		<AssemblyVersion>1.2026.0922.0</AssemblyVersion>
		<FileVersion>1.2026.0922.0</FileVersion>
		<PlatformTarget>x64</PlatformTarget>
		<!-- 让 NuGet 版本号动态绑定上面的 FileVersion！ -->
		<Version>2.1.0</Version>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="MessagePack" Version="3.1.8" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\NatsROS.Core\NatsROS.Core.csproj" />
	</ItemGroup>

</Project>
