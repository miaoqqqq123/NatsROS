<dx:ThemedWindow
    x:Class="NatsROS.Hmi.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
    Title="NatsROS 智能测试工位 - 生产模式"
    Width="1024"
    Height="800"
    Closing="Window_Closing"
    Loaded="Window_Loaded"
    WindowStartupLocation="CenterScreen">

    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--  【新增】：极其醒目的报警横幅  -->
        <Border
            x:Name="BannerAlarm"
            Grid.Row="0"
            Padding="15,10"
            Background="#D32F2F"
            Visibility="Collapsed">
            <!--  加上炫酷的阴影效果  -->
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="15"
                    Opacity="0.8"
                    ShadowDepth="5"
                    Color="Black" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Margin="0,0,20,0"
                    VerticalAlignment="Center"
                    FontSize="26"
                    FontWeight="Black"
                    Foreground="White"
                    Text="🚨 设 备 报 警" />

                <TextBlock
                    x:Name="TxtAlarmMsg"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="[ERR_VSN_001] 相机未找到定位点..."
                    TextWrapping="Wrap" />

                <dx:SimpleButton
                    x:Name="BtnAckAlarm"
                    Grid.Column="2"
                    Width="180"
                    Height="45"
                    Background="White"
                    Click="BtnAckAlarm_Click"
                    Content="确认并复位 (ACK)"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="#D32F2F" />
            </Grid>
        </Border>

        <!--  上半区：控制面板与巨型结果指示灯  -->
        <dxlc:LayoutControl Grid.Row="1" Margin="10">
            <dxlc:LayoutGroup Orientation="Horizontal">

                <!--  左侧操作区  -->
                <dxlc:LayoutGroup
                    Width="400"
                    Header="🧑‍🔧 操作台 (Operator Panel)"
                    Orientation="Vertical"
                    View="GroupBox">

                    <!--  【新增配方下拉框】  -->
                    <TextBlock
                        Margin="0,5,0,5"
                        FontSize="16"
                        Foreground="LightGray"
                        Text="生产配方 (Recipe):" />
                    <dxe:ComboBoxEdit
                        x:Name="CboRecipe"
                        Height="40"
                        DisplayMember="RecipeName"
                        FontSize="18"
                        IsTextEditable="False"
                        NullText="请选择生产配方..." />

                    <TextBlock
                        Margin="0,10,0,5"
                        FontSize="16"
                        Foreground="LightGray"
                        Text="产品条码 (Barcode):" />
                    <dxe:TextEdit
                        x:Name="TxtBarcode"
                        Height="40"
                        FontSize="24"
                        SelectAllOnGotFocus="True"
                        Text="SN-20260331-0001" />

                    <dx:SimpleButton
                        x:Name="BtnStart"
                        Height="60"
                        Margin="0,20,0,10"
                        Background="#FF2E7D32"
                        Click="BtnStart_Click"
                        Content="▶ 开始测试"
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="White" />

                    <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                        <dx:SimpleButton
                            x:Name="BtnPause"
                            Width="185"
                            Height="50"
                            Background="#FFF9A825"
                            Click="BtnPause_Click"
                            Content="⏸ 暂停 (PAUSE)"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="White" />
                        <dx:SimpleButton
                            x:Name="BtnResume"
                            Width="185"
                            Height="50"
                            Margin="10,0,0,0"
                            Background="#FF0277BD"
                            Click="BtnResume_Click"
                            Content="▶ 继续 (RESUME)"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="White"
                            IsEnabled="False" />
                    </StackPanel>

                    <dx:SimpleButton
                        x:Name="BtnEStop"
                        Height="50"
                        Background="#FFC62828"
                        Click="BtnEStop_Click"
                        Content="🛑 终止/急停"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="White" />
                </dxlc:LayoutGroup>

                <!--  右侧结果区  -->
                <dxlc:LayoutGroup
                    Margin="10,0,0,0"
                    Header="📊 最终判定 (Final Verdict)"
                    View="GroupBox">
                    <Border
                        x:Name="BorderResult"
                        Margin="10"
                        Background="#FF37474F"
                        CornerRadius="10">
                        <TextBlock
                            x:Name="TxtResult"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="96"
                            FontWeight="Black"
                            Foreground="White"
                            Text="WAITING" />
                    </Border>
                </dxlc:LayoutGroup>

                <dxlc:LayoutGroup
                    Margin="10,10,0,0"
                    Header="⚙️ 物理硬件直连监控 (Real-time Hardware Telemetry)"
                    Orientation="Vertical"
                    View="GroupBox">

                    <StackPanel>

                        <TextBlock
                            Margin="0,0,0,5"
                            Foreground="LightGray"
                            Text="点胶头 X 轴 (mm):" />
                        <dxe:ProgressBarEdit
                            x:Name="PbAxisPosX"
                            Height="30"
                            ContentDisplayMode="Value"
                            DisplayFormatString="F3"
                            FontSize="16"
                            FontWeight="Bold"
                            Maximum="500"
                            Minimum="-500" />
                    </StackPanel>
                    <StackPanel>

                        <TextBlock
                            Margin="0,0,0,5"
                            Foreground="LightGray"
                            Text="点胶头 Y 轴 (mm):" />
                        <dxe:ProgressBarEdit
                            x:Name="PbAxisPosY"
                            Height="30"
                            ContentDisplayMode="Value"
                            DisplayFormatString="F3"
                            FontSize="16"
                            FontWeight="Bold"
                            Maximum="500"
                            Minimum="-500" />
                    </StackPanel>
                    <StackPanel>

                        <TextBlock
                            Margin="0,0,0,5"
                            Foreground="LightGray"
                            Text="点胶头 Z 轴 (mm):" />
                        <dxe:ProgressBarEdit
                            x:Name="PbAxisPosZ"
                            Height="30"
                            ContentDisplayMode="Value"
                            DisplayFormatString="F3"
                            FontSize="16"
                            FontWeight="Bold"
                            Maximum="500"
                            Minimum="-500" />
                    </StackPanel>
                </dxlc:LayoutGroup>

            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>

        <!--  下半区：测试流水账实时展示  -->
        <dxlc:LayoutControl
            Grid.Row="2"
            Margin="10,0,10,10"
            Padding="0">
            <dxlc:LayoutGroup Header="📋 测试工序实时明细 (Test Step Details)" View="GroupBox">
                <dxg:GridControl x:Name="GridSteps" AutoGenerateColumns="None">
                    <dxg:GridControl.View>
                        <dxg:TableView
                            AllowEditing="False"
                            FontSize="16"
                            NavigationStyle="Row"
                            RowMinHeight="40"
                            ShowGroupPanel="False" />
                    </dxg:GridControl.View>
                    <dxg:GridColumn
                        Width="*"
                        FieldName="StepName"
                        Header="测试项名称" />
                    <dxg:GridColumn
                        Width="200"
                        FieldName="Status"
                        Header="状态 (Status)">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn
                        Width="150"
                        FieldName="Progress"
                        Header="进度">
                        <dxg:GridColumn.EditSettings>
                            <dxe:ProgressBarEditSettings
                                ContentDisplayMode="Value"
                                Maximum="100"
                                Minimum="0" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                </dxg:GridControl>
            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </Grid>
</dx:ThemedWindow>