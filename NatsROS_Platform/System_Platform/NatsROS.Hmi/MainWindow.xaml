<dx:ThemedWindow
    x:Class="NatsROS.Hmi.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
    Title="NatsROS 智能测试工位 - 生产模式"
    Width="1280"
    Height="800"
    Closing="Window_Closing"
    Loaded="Window_Loaded"
    WindowStartupLocation="CenterScreen">

    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!--  【永恒的守护】：极其醒目的 AEM 报警横幅  -->
        <Border
            x:Name="BannerAlarm"
            Grid.Row="0"
            Padding="15,10"
            Background="#D32F2F"
            Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="15"
                    Opacity="0.8"
                    ShadowDepth="5"
                    Color="Black" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Margin="0,0,20,0"
                    VerticalAlignment="Center"
                    FontSize="26"
                    FontWeight="Black"
                    Foreground="White"
                    Text="🚨 设 备 报 警" />
                <TextBlock
                    x:Name="TxtAlarmMsg"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="[ERR_001] 未知异常..."
                    TextWrapping="Wrap" />
                <dx:SimpleButton
                    x:Name="BtnAckAlarm"
                    Grid.Column="2"
                    Width="180"
                    Height="45"
                    Background="White"
                    Click="BtnAckAlarm_Click"
                    Content="确认并复位 (ACK)"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="#D32F2F" />
            </Grid>
        </Border>

        <!--  【核心重构】：中央插件工作区，所有业务 UI 全塞在这里！  -->
        <dx:DXTabControl
            x:Name="MainTabControl"
            Grid.Row="1"
            Margin="5"
            Padding="5"
            Background="Transparent"
            TabContentCacheMode="CacheTabsOnSelecting">
            <dx:DXTabControl.View>
                <dx:TabControlMultiLineView HeaderLocation="Top" />
            </dx:DXTabControl.View>
        </dx:DXTabControl>

        <!--  底部极简状态栏  -->
        <dxb:StatusBarControl Grid.Row="2" Background="#2D2D30">
            <dxb:BarStaticItem
                x:Name="StatusConnection"
                Content="NATS 网络已连接"
                Foreground="LightGreen" />
            <dxb:BarStaticItem
                x:Name="StatusPluginCount"
                Alignment="Default"
                Content="加载了 0 个工站插件"
                Foreground="Gray" />
        </dxb:StatusBarControl>
    </Grid>
</dx:ThemedWindow>