<dx:ThemedWindow
    x:Class="NatsROS.Launcher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="System Launcher"
    Width="500"
    Height="300"
    Closing="Window_Closing"
    Loaded="Window_Loaded"
    ResizeMode="NoResize"
    ShowTitle="False"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <!--  加载界面的整体布局  -->
    <Border
        Background="#1E1E1E"
        BorderBrush="#007ACC"
        BorderThickness="2"
        CornerRadius="5">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Logo 和系统名称  -->
            <StackPanel
                Grid.Row="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <!--  这里可以用 DevExpress 的内置图标，或者您自己的 SVG  -->
                <dx:DXImage
                    Width="80"
                    Height="80"
                    Margin="0,0,0,15" />
                <TextBlock
                    x:Name="TxtSysName"
                    HorizontalAlignment="Center"
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="NatsROS 智能控制系统" />
                <TextBlock
                    Margin="0,5,0,0"
                    HorizontalAlignment="Center"
                    FontSize="14"
                    Foreground="#007ACC"
                    Text="Enterprise Distributed Framework" />
            </StackPanel>

            <!--  状态提示文字  -->
            <TextBlock
                x:Name="TxtStatus"
                Grid.Row="1"
                Margin="0,0,0,10"
                FontSize="14"
                Foreground="LightGray"
                Text="正在初始化系统..." />

            <!--  进度条  -->
            <dxe:ProgressBarEdit
                x:Name="PbBoot"
                Grid.Row="2"
                Height="40"
                ContentDisplayMode="Value"
                Maximum="100"
                Minimum="0"
                ShowBorder="True"
                Value="0" />
        </Grid>
    </Border>
</dx:ThemedWindow>