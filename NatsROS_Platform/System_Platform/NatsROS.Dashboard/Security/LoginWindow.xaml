<dx:ThemedWindow
    x:Class="NatsROS.Dashboard.Security.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    Title="登录 NatsROS 系统"
    Width="350"
    MaxHeight="550"
    Background="#1E1E1E"
    ResizeMode="NoResize"
    ShowTitle="True"
    WindowStartupLocation="CenterScreen">

    <!--  增加酷炫边框  -->
    <Border BorderBrush="#00838F" BorderThickness="2">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Logo 区  -->
            <StackPanel
                Grid.Row="0"
                Margin="0,10,0,30"
                HorizontalAlignment="Center">
                <dx:DXImage
                    Width="64"
                    Height="64"
                    Margin="0,0,0,10"
                    Source="{dx:DXImage 'SvgImages/Icon Builder/Security_Key.svg'}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="NatsROS 身份认证" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="Gray"
                    Text="IAM - RBAC System" />
            </StackPanel>

            <dxe:TextEdit
                x:Name="TxtUsername"
                Grid.Row="1"
                Height="40"
                Margin="0,0,0,15"
                HorizontalContentAlignment="Center"
                FontSize="16"
                NullText="请输入用户名 (如: admin)"
                Text="admin" />

            <dxe:PasswordBoxEdit
                x:Name="TxtPassword"
                Grid.Row="2"
                Height="40"
                Margin="0,0,0,20"
                HorizontalContentAlignment="Center"
                FontSize="16"
                NullText="请输入密码 (默认: 123456)"
                Text="123456" />

            <dx:SimpleButton
                x:Name="BtnLogin"
                Grid.Row="3"
                Height="45"
                Margin="5"
                Background="#FF00838F"
                Click="BtnLogin_Click"
                Content="登 录 (LOGIN)"
                FontSize="18"
                FontWeight="Bold"
                Foreground="White" />
            <dx:SimpleButton
                x:Name="BtnCancel"
                Grid.Row="4"
                Height="45"
                Margin="5"
                Background="#FF00838F"
                Click="BtnCancel_Click"
                Content="取 消 (CANCEL)"
                FontSize="18"
                FontWeight="Bold"
                Foreground="White" />
            <TextBlock
                x:Name="LblError"
                Grid.Row="5"
                MinHeight="14"
                Margin="5"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                FontWeight="Bold"
                Foreground="#FFC62828"
                Text="请登录"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Visibility="Visible" />
        </Grid>
    </Border>
</dx:ThemedWindow>