<UserControl
    x:Class="NatsROS.Dashboard.Plugins.NodeManager.NodeManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
    xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
    xmlns:dxprg="http://schemas.devexpress.com/winfx/2008/xaml/propertygrid"
    Background="Transparent">

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  顶层统一工具栏 (BarManager)  -->
        <dxb:BarManager Grid.Row="0">
            <dxb:BarManager.Bars>
                <dxb:Bar
                    AllowCustomizationMenu="False"
                    AllowQuickCustomization="False"
                    AllowRemove="False"
                    BorderThickness="5,5,5,5"
                    Caption="节点生命周期控制栏"
                    CornerRadius="5,5,5,5"
                    GlyphSize="Large"
                    ShowDragWidget="False"
                    ShowSizeGrip="False">
                    <dxb:Bar.ItemLinks>
                        <dxb:BarButtonItemLink BarItemName="BtnRefresh" />
                        <dxb:BarItemLinkSeparator />
                        <dxb:BarButtonItemLink BarItemName="BtnStateActive" />
                        <dxb:BarButtonItemLink BarItemName="BtnStateInactive" />
                        <dxb:BarItemLinkSeparator />
                        <dxb:BarButtonItemLink BarItemName="BtnUnloadNode" />
                    </dxb:Bar.ItemLinks>
                </dxb:Bar>
            </dxb:BarManager.Bars>

            <dxb:BarManager.Items>
                <dxb:BarButtonItem
                    x:Name="BtnRefresh"
                    BarItemDisplayMode="ContentAndGlyph"
                    Content="🔄 刷新节点"
                    CornerRadius="2,2,2,2"
                    Glyph="{dx:DXImage 'SvgImages/Icon Builder/Actions_Refresh.svg'}"
                    ItemClick="BtnRefresh_Click" />
                <dxb:BarButtonItem
                    x:Name="BtnStateActive"
                    BarItemDisplayMode="ContentAndGlyph"
                    Content="▶ 激活 (Active)"
                    CornerRadius="2,2,2,2"
                    Foreground="DarkGreen"
                    Glyph="{dx:DXImage 'SvgImages/XAF/State_Validation_Valid.svg'}"
                    ItemClick="BtnStateActive_Click" />
                <dxb:BarButtonItem
                    x:Name="BtnStateInactive"
                    BarItemDisplayMode="ContentAndGlyph"
                    Content="⏸ 待机 (Inactive)"
                    CornerRadius="2,2,2,2"
                    Foreground="DarkOrange"
                    Glyph="{dx:DXImage 'SvgImages/XAF/State_Validation_Skipped.svg'}"
                    ItemClick="BtnStateInactive_Click" />
                <dxb:BarButtonItem
                    x:Name="BtnUnloadNode"
                    BarItemDisplayMode="ContentAndGlyph"
                    Content="⏹️ 强行卸载"
                    CornerRadius="2,2,2,2"
                    Foreground="DarkRed"
                    Glyph="{dx:DXImage 'SvgImages/XAF/State_Validation_Invalid.svg'}"
                    ItemClick="BtnUnloadNode_Click" />
            </dxb:BarManager.Items>
        </dxb:BarManager>

        <!--  主体区域：工作区  -->
        <Grid Grid.Row="1" Margin="4">
            <dxdo:DockLayoutManager>
                <dxdo:LayoutGroup Orientation="Horizontal">

                    <!--  1. 左侧：智能组件库 (带有底部描述)  -->
                    <dxdo:LayoutGroup Orientation="Vertical">
                        <dxdo:LayoutPanel
                            MinWidth="240"
                            AllowClose="False"
                            Caption="🛒 智能组件库 (双击单点发射)"
                            ItemHeight="5*"
                            ShowCloseButton="False"
                            ShowPinButton="False">
                            <Grid Margin="5">
                                <dxg:GridControl
                                    x:Name="GridAvailableNodes"
                                    AutoGenerateColumns="None"
                                    MouseDoubleClick="GridAvailableNodes_MouseDoubleClick">
                                    <dxg:GridControl.View>
                                        <dxg:TableView
                                            AllowEditing="False"
                                            NavigationStyle="Row"
                                            SearchPanelAllowFilter="True"
                                            ShowGroupPanel="True"
                                            ShowSearchPanelMode="Always" />
                                    </dxg:GridControl.View>
                                    <dxg:GridColumn
                                        FieldName="Category"
                                        GroupIndex="0"
                                        Header="分类" />
                                    <dxg:GridColumn
                                        Width="*"
                                        FieldName="FullDisplayName"
                                        Header="组件名称" />
                                </dxg:GridControl>
                            </Grid>
                        </dxdo:LayoutPanel>

                        <dxdo:LayoutPanel
                            MinWidth="240"
                            AllowClose="False"
                            Caption="描述 (Description)"
                            ShowCloseButton="False"
                            ShowPinButton="False">
                            <Grid Margin="5">
                                <StackPanel>
                                    <TextBlock
                                        Margin="0,0,0,5"
                                        FontWeight="Bold"
                                        Text="{Binding ElementName=GridAvailableNodes, Path=SelectedItem.FullDisplayName, StringFormat='名称: {0}'}" />
                                    <TextBlock
                                        Foreground="DarkGray"
                                        Text="{Binding ElementName=GridAvailableNodes, Path=SelectedItem.Description, StringFormat='描述: {0}'}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </dxdo:LayoutPanel>
                    </dxdo:LayoutGroup>

                    <!--  2. 中间：运行中的微服务节点清单  -->
                    <dxdo:LayoutPanel
                        MinWidth="240"
                        AllowClose="False"
                        Caption="🟢 运行中的微服务节点 (Active Nodes)"
                        ItemWidth="3*"
                        ShowCloseButton="False"
                        ShowPinButton="False">
                        <Grid>
                            <dxg:GridControl
                                x:Name="GridNodes"
                                AutoGenerateColumns="None"
                                SelectedItemChanged="GridNodes_SelectedItemChanged">
                                <dxg:GridControl.View>
                                    <dxg:TableView
                                        AllowEditing="False"
                                        NavigationStyle="Row"
                                        ShowGroupPanel="False" />
                                </dxg:GridControl.View>
                                <dxg:GridColumn
                                    Width="180"
                                    FieldName="NodeName"
                                    Header="实例名称" />
                                <dxg:GridColumn
                                    Width="*"
                                    AllowEditing="False"
                                    FieldName="TypeName"
                                    Header="类名(Class)"
                                    ReadOnly="True" />
                                <dxg:GridColumn
                                    Width="100"
                                    AllowEditing="False"
                                    FieldName="Version"
                                    Header="版本(Version)"
                                    ReadOnly="True">
                                    <dxg:GridColumn.CellStyle>
                                        <Style TargetType="dxg:LightweightCellEditor">
                                            <Setter Property="Foreground" Value="Orange" />

                                        </Style>
                                    </dxg:GridColumn.CellStyle>
                                </dxg:GridColumn>
                                <dxg:GridColumn
                                    Width="*"
                                    FieldName="StateStr"
                                    Header="生命周期状态">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                            </dxg:GridControl>
                        </Grid>
                    </dxdo:LayoutPanel>

                    <!--  3. 右侧：节点参数热更面板  -->
                    <dxdo:LayoutPanel
                        x:Name="GrpNodeParams"
                        MinWidth="240"
                        AllowClose="False"
                        Caption="⚙️ 节点参数热更 (Properties)"
                        ShowCloseButton="False"
                        ShowPinButton="False">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <dxprg:PropertyGridControl
                                x:Name="PropGridParams"
                                Grid.Row="0"
                                CellValueChanged="PropGridParams_CellValueChanged"
                                ExpandCategoriesWhenSelectedObjectChanged="True"
                                ShowDescriptionIn="Panel"
                                ShowSearchBox="True" />

                            <dx:SimpleButton
                                x:Name="BtnApplyParams"
                                Grid.Row="1"
                                Height="32"
                                Margin="0,10,0,0"
                                Click="BtnApplyParams_Click"
                                Content="🔥 下发热更新 (Apply)"
                                IsEnabled="False" />
                        </Grid>
                    </dxdo:LayoutPanel>

                </dxdo:LayoutGroup>
            </dxdo:DockLayoutManager>
        </Grid>
    </Grid>
</UserControl>