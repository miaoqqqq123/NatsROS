<UserControl
    x:Class="NatsROS.Dashboard.Plugins.AemCenter.AemCenterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
    Background="Transparent">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="5" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <!--  ==========================================  -->
        <!--  1. 顶部纯净版 HUD (头条报警，无任何按钮)  -->
        <!--  ==========================================  -->
        <Border
            x:Name="AlertCard"
            Grid.Row="0"
            Margin="0,0,0,10"
            Padding="15"
            Background="#FF37474F"
            CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <dx:DXImage
                    x:Name="IconAlert"
                    Grid.Column="0"
                    Width="48"
                    Height="48"
                    Margin="0,0,15,0"
                    Source="{dx:DXImage 'SvgImages/Icon Builder/Security_Warning.svg'}" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        x:Name="TxtAlertTitle"
                        FontSize="20"
                        FontWeight="Black"
                        Foreground="White"
                        Text="✅ 当前系统无报警" />
                    <TextBlock
                        x:Name="TxtAlertMessage"
                        Margin="0,5,0,0"
                        FontSize="14"
                        Foreground="LightGray"
                        Text="所有设备运行正常"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  ==========================================  -->
        <!--  2. 中部：华丽双标签页 (实时报警 vs 历史台账)  -->
        <!--  ==========================================  -->
        <dx:DXTabControl
            Grid.Row="1"
            Margin="0,0,0,5"
            Background="Transparent">
            <dx:DXTabControl.View>
                <dx:TabControlMultiLineView HeaderLocation="Top" />
            </dx:DXTabControl.View>

            <!--  🟢 TAB 1: 实时活动报警  -->
            <dx:DXTabItem Header="🔴 实时活动报警 (Active Alarms)">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  列表头部的批量操作栏  -->
                    <StackPanel
                        Grid.Row="0"
                        Margin="0,5,0,5"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <dx:SimpleButton
                            x:Name="BtnMute"
                            Height="30"
                            Margin="0,0,10,0"
                            Background="#FF546E7A"
                            Click="BtnMute_Click"
                            Content="🔕 消音 (Mute)"
                            FontWeight="Bold"
                            Foreground="White" />

                        <dx:SimpleButton
                            x:Name="BtnAckAll"
                            Height="30"
                            Background="#FFC62828"
                            Click="BtnAckAll_Click"
                            Content="✅ 一键确认所有 (ACK ALL)"
                            FontWeight="Bold"
                            Foreground="White"
                            IsEnabled="False" />
                    </StackPanel>

                    <dxg:GridControl
                        x:Name="GridAlarms"
                        Grid.Row="1"
                        AutoGenerateColumns="None">
                        <dxg:GridControl.View>
                            <dxg:TableView
                                AllowEditing="False"
                                AlternateRowBackground="#2D2D30"
                                NavigationStyle="Row"
                                ShowGroupPanel="False">

                                <!--  屏蔽菜单  -->
                                <dxg:TableView.RowCellMenuCustomizations>
                                    <dxb:BarButtonItem
                                        Content="🔕 临时屏蔽此报警 (30 分钟)"
                                        Glyph="{dx:DXImage 'SvgImages/Icon Builder/Security_WarningOff.svg'}"
                                        ItemClick="MenuBypass30_ItemClick" />
                                    <dxb:BarButtonItem
                                        Content="🔕 临时屏蔽此报警 (2 小时)"
                                        Glyph="{dx:DXImage 'SvgImages/Icon Builder/Security_WarningOff.svg'}"
                                        ItemClick="MenuBypass120_ItemClick" />
                                    <dxb:BarButtonItem
                                        Content="🔕 临时屏蔽此报警 (8 小时 / 跨班)"
                                        Glyph="{dx:DXImage 'SvgImages/Icon Builder/Security_WarningOff.svg'}"
                                        ItemClick="MenuBypass480_ItemClick" />
                                </dxg:TableView.RowCellMenuCustomizations>

                                <!--  条件格式化引擎  -->
                                <dxg:TableView.FormatConditions>
                                    <dxg:FormatCondition ApplyToRow="True" Expression="[Status] == 'Raised' And [Level] == 'Critical'">
                                        <dx:Format
                                            Background="#33FF0000"
                                            FontWeight="Bold"
                                            Foreground="#FFFFCCCC" />
                                    </dxg:FormatCondition>
                                    <dxg:FormatCondition ApplyToRow="True" Expression="[Status] == 'Raised' And [Level] == 'Warning'">
                                        <dx:Format
                                            Background="#33FF9800"
                                            FontWeight="Bold"
                                            Foreground="#FFFFE0B2" />
                                    </dxg:FormatCondition>
                                    <dxg:FormatCondition ApplyToRow="True" Expression="[Status] == 'Cleared'">
                                        <dx:Format FontWeight="Bold" Foreground="#FF4CAF50" />
                                    </dxg:FormatCondition>
                                    <dxg:FormatCondition ApplyToRow="True" Expression="[Status] == 'Acknowledged'">
                                        <dx:Format Foreground="Gray" TextDecorations="Strikethrough" />
                                    </dxg:FormatCondition>
                                </dxg:TableView.FormatConditions>
                            </dxg:TableView>
                        </dxg:GridControl.View>

                        <dxg:GridColumn
                            Width="180"
                            FieldName="FormattedTime"
                            Header="发生时间" />
                        <dxg:GridColumn
                            Width="100"
                            FieldName="Level"
                            Header="等级" />
                        <dxg:GridColumn
                            Width="150"
                            FieldName="Code"
                            Header="报警代码" />
                        <dxg:GridColumn
                            Width="*"
                            FieldName="FormattedMessage"
                            Header="详细描述" />
                        <dxg:GridColumn
                            Width="80"
                            FieldName="Occurrences"
                            Header="发生频次" />
                        <dxg:GridColumn
                            Width="120"
                            FieldName="Status"
                            Header="当前状态" />
                        <dxg:GridColumn
                            Width="90"
                            FieldName="AllowBypassStr"
                            Header="允许屏蔽" />

                        <!--  【新增魔法】：行级 ACK 按钮列  -->
                        <dxg:GridColumn
                            Width="100"
                            FixedWidth="True"
                            Header="操作"
                            HorizontalHeaderContentAlignment="Center">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <dx:SimpleButton
                                        Margin="4,2"
                                        Padding="10,2"
                                        Background="#FF0288D1"
                                        Click="BtnRowAck_Click"
                                        Content="ACK"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        IsEnabled="{Binding RowData.Row.CanAck}"
                                        Tag="{Binding RowData.Row}" />
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>
                    </dxg:GridControl>
                </Grid>
            </dx:DXTabItem>

            <!--  🟢 TAB 2: 历史追溯台账  -->
            <dx:DXTabItem Header="📜 历史追溯台账 (Audit Trail)">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <dx:SimpleButton
                        Grid.Row="0"
                        Height="30"
                        Margin="0,5,0,5"
                        Click="BtnRefreshHistory_Click"
                        Content="🔄 刷新历史记录 (最近 1000 条)" />

                    <dxg:GridControl
                        x:Name="GridHistory"
                        Grid.Row="1"
                        AutoGenerateColumns="None">
                        <dxg:GridControl.View>
                            <dxg:TableView
                                AllowEditing="False"
                                NavigationStyle="Row"
                                SearchPanelAllowFilter="True"
                                ShowGroupPanel="True"
                                ShowSearchPanelMode="Always" />
                        </dxg:GridControl.View>
                        <dxg:GridColumn
                            Width="180"
                            FieldName="FormattedTime"
                            Header="时间戳" />
                        <dxg:GridColumn
                            Width="150"
                            FieldName="Code"
                            Header="报警代码" />
                        <dxg:GridColumn
                            Width="150"
                            FieldName="Action"
                            Header="动作 (Action)">
                            <dxg:GridColumn.CellStyle>
                                <Style TargetType="dxg:LightweightCellEditor">
                                    <Setter Property="Foreground" Value="#00BCD4" />
                                </Style>
                            </dxg:GridColumn.CellStyle>
                        </dxg:GridColumn>
                        <dxg:GridColumn
                            Width="150"
                            FieldName="Operator"
                            Header="操作员" />
                        <dxg:GridColumn
                            Width="*"
                            FieldName="Details"
                            Header="审计详情" />
                    </dxg:GridControl>
                </Grid>
            </dx:DXTabItem>
        </dx:DXTabControl>

        <GridSplitter
            Grid.Row="2"
            HorizontalAlignment="Stretch"
            Background="Transparent" />

        <!--  ==========================================  -->
        <!--  3. 底部：SOP 诊断指导面板  -->
        <!--  ==========================================  -->
        <dxlc:LayoutGroup
            Grid.Row="3"
            Header="💡 标准作业指导 (SOP) 与诊断建议"
            View="GroupBox">
            <TextBlock
                Margin="10"
                FontSize="16"
                Foreground="#00BCD4"
                Text="{Binding ElementName=GridAlarms, Path=SelectedItem.Solution, FallbackValue='请在上方活动列表中选择一条报警，以查看解决方案。'}"
                TextWrapping="Wrap" />
        </dxlc:LayoutGroup>
    </Grid>
</UserControl>