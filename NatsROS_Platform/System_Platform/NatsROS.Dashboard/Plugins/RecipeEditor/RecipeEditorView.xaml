<UserControl
    x:Class="NatsROS.Dashboard.Plugins.RecipeEditor.RecipeEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
    xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
    xmlns:dxprg="http://schemas.devexpress.com/winfx/2008/xaml/propertygrid"
    Background="Transparent">

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <dxb:BarManager Grid.Row="0">
            <!--  DevExpress 工具栏菜单定义（干净纯粹的动作按钮栏）  -->
            <dxb:BarManager.Bars>
                <dxb:Bar
                    AllowCustomizationMenu="False"
                    AllowQuickCustomization="False"
                    AllowRemove="False"
                    BorderThickness="5,5,5,5"
                    Caption="配方操作工具栏"
                    CornerRadius="5,5,5,5"
                    GlyphSize="Large"
                    ShowDragWidget="False"
                    ShowSizeGrip="False">
                    <dxb:Bar.ItemLinks>
                        <!--  编辑操作组  -->
                        <dxb:BarButtonItemLink BarItemName="BtnLoadRecipe" ShowScreenTip="Default" />
                        <dxb:BarButtonItemLink BarItemName="BtnSaveRecipe" />

                        <dxb:BarItemLinkSeparator />

                        <dxb:BarButtonItemLink BarItemName="BtnLaunchAll" />

                    </dxb:Bar.ItemLinks>
                </dxb:Bar>
            </dxb:BarManager.Bars>

            <!--  工具栏条目定义  -->
            <dxb:BarManager.Items>
                <dxb:BarButtonItem
                    x:Name="BtnLoadRecipe"
                    BarItemDisplayMode="ContentAndGlyph"
                    Content="导入 launch.json"
                    CornerRadius="2,2,2,2"
                    Glyph="{dx:DXImage 'SvgImages/Actions/Open.svg'}"
                    ItemClick="BtnLoadRecipe_Click" />
                <dxb:BarButtonItem
                    x:Name="BtnSaveRecipe"
                    BarItemDisplayMode="ContentAndGlyph"
                    Content="导出为开机配方"
                    CornerRadius="2,2,2,2"
                    Glyph="{dx:DXImage 'SvgImages/Save/Save.svg'}"
                    ItemClick="BtnSaveRecipe_Click" />
                <dxb:BarButtonItem
                    x:Name="BtnLaunchAll"
                    BarItemDisplayMode="ContentAndGlyph"
                    Content="🚀 一键发射 (Launch All)"
                    Foreground="DarkGreen"
                    Glyph="{dx:DXImage 'SvgImages/XAF/Action_Edit.svg'}"
                    ItemClick="BtnLaunchAll_Click" />
            </dxb:BarManager.Items>
        </dxb:BarManager>

        <Grid Grid.Row="1" Margin="4">
            <!--  主体区域：统一托管中央配方库与工作区  -->
            <dxdo:DockLayoutManager>
                <dxdo:LayoutGroup Orientation="Horizontal">
                    <!--  1. 左侧：智能组件库 (带有底部描述)  -->
                    <dxdo:LayoutGroup Orientation="Vertical">
                        <dxdo:LayoutPanel
                            MinWidth="240"
                            AllowClose="False"
                            Caption="🛒 组件库 (双击加入配方)"
                            ItemHeight="5*"
                            ShowCloseButton="False"
                            ShowPinButton="False">
                            <Grid Margin="5">
                                <dxg:GridControl
                                    x:Name="GridAvailableNodes"
                                    AutoGenerateColumns="None"
                                    MouseDoubleClick="GridAvailableNodes_MouseDoubleClick">
                                    <dxg:GridControl.View>
                                        <dxg:TableView
                                            AllowEditing="False"
                                            NavigationStyle="Row"
                                            SearchPanelAllowFilter="True"
                                            ShowGroupPanel="True"
                                            ShowSearchPanelMode="Always" />
                                    </dxg:GridControl.View>
                                    <dxg:GridColumn
                                        FieldName="Category"
                                        GroupIndex="0"
                                        Header="分类" />
                                    <dxg:GridColumn
                                        Width="*"
                                        FieldName="FullDisplayName"
                                        Header="组件名称" />
                                    <dxg:GridColumn
                                        Width="80"
                                        FieldName="Version"
                                        Header="版本" />
                                </dxg:GridControl>
                            </Grid>



                        </dxdo:LayoutPanel>
                        <dxdo:LayoutPanel
                            MinWidth="240"
                            AllowClose="False"
                            Caption="描述 (Description)"
                            ShowCloseButton="False"
                            ShowPinButton="False">
                            <Grid Margin="5">
                                <StackPanel>
                                    <TextBlock
                                        Margin="0,0,0,5"
                                        FontWeight="Bold"
                                        Text="{Binding ElementName=GridAvailableNodes, Path=SelectedItem.FullDisplayName, StringFormat='名称: {0}'}" />
                                    <TextBlock
                                        Foreground="DarkGray"
                                        Text="{Binding ElementName=GridAvailableNodes, Path=SelectedItem.Description, StringFormat='描述: {0}'}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </dxdo:LayoutPanel>
                    </dxdo:LayoutGroup>


                    <!--  2. 中间：待启动清单 (带有下拉框的自愈策略)  -->
                    <dxdo:LayoutPanel
                        MinWidth="240"
                        AllowClose="False"
                        Caption="📝 待启动实例清单 (Recipe Nodes)"
                        ItemWidth="3*"
                        ShowCloseButton="False"
                        ShowPinButton="False">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <dxg:GridControl
                                x:Name="GridRecipeNodes"
                                Grid.Row="0"
                                AutoGenerateColumns="None"
                                SelectedItemChanged="GridRecipeNodes_SelectedItemChanged">
                                <dxg:GridControl.View>
                                    <dxg:TableView
                                        AllowEditing="True"
                                        EnableImmediatePosting="True"
                                        NavigationStyle="Cell"
                                        ShowGroupPanel="False" />
                                </dxg:GridControl.View>
                                <dxg:GridColumn
                                    Width="120"
                                    AllowEditing="True"
                                    FieldName="NodeName"
                                    Header="实例名称(Name)" />
                                <dxg:GridColumn
                                    Width="*"
                                    AllowEditing="False"
                                    FieldName="TypeName"
                                    Header="类名(Class)"
                                    ReadOnly="True" />
                                <dxg:GridColumn
                                    Width="90"
                                    AllowEditing="False"
                                    FieldName="Version"
                                    Header="版本(Version)"
                                    ReadOnly="True">
                                    <dxg:GridColumn.CellStyle>
                                        <Style TargetType="dxg:LightweightCellEditor">
                                            <Setter Property="Foreground" Value="Orange" />

                                        </Style>
                                    </dxg:GridColumn.CellStyle>
                                </dxg:GridColumn>
                                <!--  【核心魔法】：把数字变成了完美的下拉框  -->
                                <dxg:GridColumn
                                    Width="180"
                                    FieldName="RestartPolicy"
                                    Header="崩溃自愈策略 (Policy)">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings
                                            x:Name="CboRestartPolicySettings"
                                            DisplayMember="Name"
                                            IsTextEditable="False"
                                            ValueMember="Id" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                            </dxg:GridControl>

                            <dx:SimpleButton
                                Grid.Row="1"
                                Height="30"
                                Margin="0,10,0,0"
                                Click="BtnRemoveRecipeNode_Click"
                                Content="❌ 移除选中实例" />
                        </Grid>
                    </dxdo:LayoutPanel>

                    <!--  3. 右侧：分组参数表与描述 (对标 OpenTAP)  -->
                    <dxdo:LayoutPanel
                        x:Name="GrpParams"
                        MinWidth="240"
                        AllowClose="False"
                        Caption="⚙️ 参数配置 (Properties)"
                        ShowCloseButton="False"
                        ShowPinButton="False">
                        <Grid>
                            <!--  【核心替换】：换成 PropertyGridControl  -->
                            <!--  ShowDescriptionIn="Panel" 会自动在底部开辟一个极其专业的描述说明区！  -->
                            <dxprg:PropertyGridControl
                                x:Name="PropGridParams"
                                CellValueChanged="PropGridParams_CellValueChanged"
                                ExpandCategoriesWhenSelectedObjectChanged="True"
                                ShowDescriptionIn="Panel"
                                ShowSearchBox="True">

                                <!--  预埋一个文件路径拦截器 (如果有的参数是选文件的话)  -->
                                <dxprg:PropertyGridControl.PropertyDefinitions>
                                    <dxprg:PropertyDefinition Path="*Path">
                                        <dxprg:PropertyDefinition.EditSettings>
                                            <dxe:ButtonEditSettings AllowDefaultButton="True" DefaultButtonClick="BtnBrowseFile_Click" />
                                        </dxprg:PropertyDefinition.EditSettings>
                                    </dxprg:PropertyDefinition>
                                </dxprg:PropertyGridControl.PropertyDefinitions>

                            </dxprg:PropertyGridControl>
                        </Grid>
                    </dxdo:LayoutPanel>

                </dxdo:LayoutGroup>
            </dxdo:DockLayoutManager>
        </Grid>
    </Grid>
</UserControl>