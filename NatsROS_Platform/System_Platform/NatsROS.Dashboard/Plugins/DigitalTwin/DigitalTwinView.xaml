<UserControl
    x:Class="NatsROS.Dashboard.Plugins.DigitalTwin.DigitalTwinView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
    xmlns:helix="http://helix-toolkit.org/wpf"
    Background="#1E1E1E">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!--  左侧：3D 渲染引擎画布  -->
        <helix:HelixViewport3D
            x:Name="Viewport3D"
            Grid.Column="0"
            Background="#1E1E1E"
            ShowCoordinateSystem="True"
            ZoomExtentsWhenLoaded="True">
            <helix:DefaultLights />
            <helix:GridLinesVisual3D
                Width="200"
                Fill="#333333"
                Length="200"
                MajorDistance="50"
                MinorDistance="10"
                Thickness="0.5" />
            <helix:CoordinateSystemVisual3D ArrowLengths="20" />

            <!--  【升级】：产品底座容器 (不再写死 Box，而是等待装载真实 3D Mesh)  -->
            <ModelVisual3D x:Name="ProductModelContainer" />

            <!--  【升级】：点胶机头容器 (动态移动的宿主)  -->
            <ModelVisual3D x:Name="DispenserHeadModel">
                <!--  我们先给它塞一个默认的绿色小圆柱兜底，一旦导入了真实模型，这个就会被替换掉  -->
                <helix:BoxVisual3D
                    x:Name="DefaultHead"
                    Width="5"
                    Height="20"
                    Fill="LimeGreen"
                    Length="5" />
            </ModelVisual3D>

            <helix:LinesVisual3D
                x:Name="GlueLines"
                Thickness="5"
                Color="OrangeRed" />
            <helix:LinesVisual3D
                x:Name="MoveLines"
                Thickness="1"
                Color="DarkGray" />
        </helix:HelixViewport3D>

        <!--  右侧：控制面板与遥测数据  -->
        <dxlc:LayoutControl Grid.Column="1" Padding="10">
            <dxlc:LayoutGroup
                Header="🎯 孪生遥测 (Telemetry)"
                Orientation="Vertical"
                View="GroupBox">

                <TextBlock
                    Height="16"
                    Margin="0,0,0,10"
                    Foreground="LightGray"
                    Text="实时物理空间坐标:" />
                <StackPanel
                    Grid.Row="1"
                    Height="24"
                    Margin="0,0,0,5"
                    Orientation="Horizontal">
                    <TextBlock
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="Red"
                        Text="X: " />
                    <TextBlock
                        x:Name="TxtLiveX"
                        FontSize="18"
                        Foreground="White"
                        Text="0.00" />
                </StackPanel>
                <StackPanel
                    Grid.Row="2"
                    Height="24"
                    Margin="0,0,0,5"
                    Orientation="Horizontal">
                    <TextBlock
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="Green"
                        Text="Y: " />
                    <TextBlock
                        x:Name="TxtLiveY"
                        FontSize="18"
                        Foreground="White"
                        Text="0.00" />
                </StackPanel>
                <StackPanel
                    Grid.Row="3"
                    Height="24"
                    Margin="0,0,0,5"
                    Orientation="Horizontal">
                    <TextBlock
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="DodgerBlue"
                        Text="Z: " />
                    <TextBlock
                        x:Name="TxtLiveZ"
                        FontSize="18"
                        Foreground="White"
                        Text="50.00" />
                </StackPanel>

                <!--  【新增】：真实的 3D 模型导入工具  -->
                <Separator Margin="0,0,0,15" Background="#444" />
                <TextBlock
                    Height="14"
                    Margin="0,0,0,10"
                    Foreground="LightGray"
                    Text="模型渲染 (CAD to Mesh):" />
                <dx:SimpleButton
                    x:Name="BtnLoadProduct"
                    Height="30"
                    Margin="0,0,0,5"
                    Background="#FF37474F"
                    Click="BtnLoadProduct_Click"
                    Content="📥 导入产品模型 (STL/OBJ)"
                    Foreground="White" />
                <dx:SimpleButton
                    x:Name="BtnLoadMachine"
                    Height="30"
                    Margin="0,0,0,20"
                    Background="#FF37474F"
                    Click="BtnLoadMachine_Click"
                    Content="📥 导入机头模型 (STL/OBJ)"
                    Foreground="White" />

                <Separator Margin="0,0,0,15" Background="#444" />
                <TextBlock
                    Height="16"
                    Margin="0,0,0,10"
                    Foreground="LightGray"
                    Text="高级宏指令演示 (Macro Tests):" />

                <dxlc:LayoutItem Label="目标 X:">
                    <dxe:SpinEdit
                        x:Name="SpinTargetX"
                        MaxValue="100"
                        MinValue="-100"
                        Value="50" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="目标 Y:">
                    <dxe:SpinEdit
                        x:Name="SpinTargetY"
                        MaxValue="100"
                        MinValue="-100"
                        Value="50" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="目标 Z:">
                    <dxe:SpinEdit
                        x:Name="SpinTargetZ"
                        MaxValue="100"
                        MinValue="0"
                        Value="10" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="速度:">
                    <dxe:SpinEdit
                        x:Name="SpinVel"
                        MaxValue="200"
                        MinValue="1"
                        Value="50" />
                </dxlc:LayoutItem>

                <Separator Margin="0,0,0,15" Background="#444" />
                <TextBlock
                    Height="16"
                    Margin="0,0,0,10"
                    Foreground="LightGray"
                    Text="视觉引导与仿射变换测试:" />

                <!--  【新增】模拟工人没放正  -->
                <dx:SimpleButton
                    x:Name="BtnSimulateSkew"
                    Height="30"
                    Margin="0,0,0,10"
                    Background="#FFB71C1C"
                    Click="BtnSimulateSkew_Click"
                    Content="🎲 1. 模拟工人放歪产品"
                    Foreground="White" />

                <dx:SimpleButton
                    x:Name="BtnSendGoal"
                    Height="30"
                    Margin="0,0,0,10"
                    Background="#FF37474F"
                    Click="BtnSendGoal_Click"
                    Content="2. 绝对坐标单点移动"
                    Foreground="White" />

                <!--  【修改】加入视觉纠偏  -->
                <dx:SimpleButton
                    x:Name="BtnDrawRect"
                    Height="45"
                    Margin="0,0,0,10"
                    Background="#FF2E7D32"
                    Click="BtnDrawRect_Click"
                    Content="🧠 3. 呼叫大脑执行工艺"
                    FontWeight="Bold"
                    Foreground="White" />

                <dx:SimpleButton
                    x:Name="BtnClearLines"
                    Height="30"
                    Background="#FFC62828"
                    Click="BtnClearLines_Click"
                    Content="🧹 清空胶路"
                    Foreground="White" />

            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </Grid>
</UserControl>