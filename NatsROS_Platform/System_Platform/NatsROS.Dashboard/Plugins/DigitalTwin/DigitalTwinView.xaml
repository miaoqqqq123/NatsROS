<UserControl
    x:Class="NatsROS.Dashboard.Plugins.DigitalTwin.DigitalTwinView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
    xmlns:helix="http://helix-toolkit.org/wpf"
    Background="#1E1E1E">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!--  左侧：3D 渲染引擎画布  -->
        <helix:HelixViewport3D
            x:Name="Viewport3D"
            Grid.Column="0"
            Background="#1E1E1E"
            ShowCoordinateSystem="True"
            ZoomExtentsWhenLoaded="True">
            <helix:DefaultLights />
            <helix:GridLinesVisual3D
                Width="300"
                Fill="#333333"
                Length="300"
                MajorDistance="50"
                MinorDistance="10"
                Thickness="0.5" />
            <helix:CoordinateSystemVisual3D ArrowLengths="20" />

            <!--  ==========================================  -->
            <!--  1. Y1 工站平台与产品  -->
            <!--  ==========================================  -->
            <ModelVisual3D x:Name="StationY1Container">
                <helix:BoxVisual3D
                    Width="80"
                    Height="10"
                    Center="-60, 100, -5"
                    Fill="SteelBlue"
                    Length="100" />
                <!--  预留包裹产品的容器，用于上下料显示/隐藏和旋转  -->
                <ModelVisual3D x:Name="ProductY1Container">
                    <helix:BoxVisual3D
                        x:Name="DefaultProductY1"
                        Width="50"
                        Height="5"
                        Center="-60, 100, 2.5"
                        Fill="Gray"
                        Length="70" />
                </ModelVisual3D>
                <helix:LinesVisual3D
                    x:Name="GlueLinesY1"
                    Thickness="5"
                    Color="OrangeRed" />
            </ModelVisual3D>

            <!--  ==========================================  -->
            <!--  2. Y2 工站平台与产品  -->
            <!--  ==========================================  -->
            <ModelVisual3D x:Name="StationY2Container">
                <helix:BoxVisual3D
                    Width="80"
                    Height="10"
                    Center="60, 100, -5"
                    Fill="DarkSlateBlue"
                    Length="100" />
                <ModelVisual3D x:Name="ProductY2Container">
                    <helix:BoxVisual3D
                        x:Name="DefaultProductY2"
                        Width="50"
                        Height="5"
                        Center="60, 100, 2.5"
                        Fill="Gray"
                        Length="70" />
                </ModelVisual3D>
                <helix:LinesVisual3D
                    x:Name="GlueLinesY2"
                    Thickness="5"
                    Color="OrangeRed" />
            </ModelVisual3D>

            <!--  ==========================================  -->
            <!--  3. 点胶机头 (只在 X/Z 运动)  -->
            <!--  ==========================================  -->
            <ModelVisual3D x:Name="DispenserHeadModel">
                <helix:BoxVisual3D
                    x:Name="DefaultHead"
                    Width="5"
                    Height="20"
                    Fill="LimeGreen"
                    Length="5" />
            </ModelVisual3D>
            <helix:LinesVisual3D
                x:Name="MoveLines"
                Thickness="1"
                Color="DarkGray" />

            <!--  ==========================================  -->
            <!--  4. 扫码枪与激光 (悬浮在进站口 Y=50 处)  -->
            <!--  ==========================================  -->
            <ModelVisual3D>
                <helix:BoxVisual3D
                    Width="10"
                    Height="10"
                    Center="-60, 50, 40"
                    Fill="DarkGray"
                    Length="10" />
                <helix:TruncatedConeVisual3D
                    x:Name="LaserY1"
                    Height="35"
                    BaseRadius="20"
                    Normal="0,0,-1"
                    Origin="-60,50,35"
                    TopRadius="0">
                    <helix:TruncatedConeVisual3D.Fill>
                        <SolidColorBrush Color="#00FF0000" />
                    </helix:TruncatedConeVisual3D.Fill>
                </helix:TruncatedConeVisual3D>
            </ModelVisual3D>
            <ModelVisual3D>
                <helix:BoxVisual3D
                    Width="10"
                    Height="10"
                    Center="60, 50, 40"
                    Fill="DarkGray"
                    Length="10" />
                <helix:TruncatedConeVisual3D
                    x:Name="LaserY2"
                    Height="35"
                    BaseRadius="20"
                    Normal="0,0,-1"
                    Origin="60,50,35"
                    TopRadius="0">
                    <helix:TruncatedConeVisual3D.Fill>
                        <SolidColorBrush Color="#00FF0000" />
                    </helix:TruncatedConeVisual3D.Fill>
                </helix:TruncatedConeVisual3D>
            </ModelVisual3D>
        </helix:HelixViewport3D>

        <!--  右侧：控制面板与遥测数据  -->
        <dxlc:LayoutControl Grid.Column="1" Padding="10">
            <dxlc:LayoutGroup
                Header="🎯 产线沙盘总控台"
                Orientation="Vertical"
                View="GroupBox">

                <!--  遥测数据  -->
                <TextBlock
                    Margin="0,0,0,5"
                    Foreground="LightGray"
                    Text="机头与工站绝对物理坐标:" />
                <StackPanel Margin="0,0,0,5" Orientation="Horizontal">
                    <TextBlock
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="Red"
                        Text="机头 X/Z: " />
                    <TextBlock
                        x:Name="TxtLiveX"
                        FontSize="16"
                        Foreground="White"
                        Text="0.00" />
                    <TextBlock
                        FontSize="16"
                        Foreground="White"
                        Text=" / " />
                    <TextBlock
                        x:Name="TxtLiveZ"
                        FontSize="16"
                        Foreground="White"
                        Text="50.00" />
                </StackPanel>
                <StackPanel Margin="0,0,0,5" Orientation="Horizontal">
                    <TextBlock
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="DodgerBlue"
                        Text="平台 Y1: " />
                    <TextBlock
                        x:Name="TxtLiveY1"
                        FontSize="16"
                        Foreground="White"
                        Text="100.00" />
                </StackPanel>
                <StackPanel Margin="0,0,0,15" Orientation="Horizontal">
                    <TextBlock
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="MediumPurple"
                        Text="平台 Y2: " />
                    <TextBlock
                        x:Name="TxtLiveY2"
                        FontSize="16"
                        Foreground="White"
                        Text="100.00" />
                </StackPanel>

                <!--  自动线全局启停  -->
                <Separator Margin="0,0,0,15" Background="#444" />
                <TextBlock
                    Margin="0,0,0,10"
                    Foreground="LightGray"
                    Text="全局自动线启停 (Auto Mode):" />

                <dx:SimpleButton
                    x:Name="BtnStartAll"
                    Height="50"
                    Margin="0,0,0,10"
                    Background="#FF2E7D32"
                    Click="BtnStartAll_Click"
                    Content="▶️ 一键启动全线 (START ALL)"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="White" />
                <dx:SimpleButton
                    x:Name="BtnStopAll"
                    Height="40"
                    Margin="0,0,0,15"
                    Background="#FFC62828"
                    Click="BtnStopAll_Click"
                    Content="🛑 一键挂起全线 (STOP ALL)"
                    FontWeight="Bold"
                    Foreground="White" />

                <!--  模拟与清空  -->
                <Separator Margin="0,0,0,15" Background="#444" />
                <TextBlock
                    Margin="0,0,0,10"
                    Foreground="LightGray"
                    Text="异常模拟与显示清理:" />

                <dx:SimpleButton
                    x:Name="BtnSimulateSkewY1"
                    Height="30"
                    Margin="0,0,0,10"
                    Background="#FFB71C1C"
                    Click="BtnSimulateSkewY1_Click"
                    Content="🎲 模拟工人将 Y1 放歪"
                    Foreground="White" />
                <dx:SimpleButton
                    x:Name="BtnSimulateSkewY2"
                    Height="30"
                    Margin="0,0,0,15"
                    Background="#FF6A1B9A"
                    Click="BtnSimulateSkewY2_Click"
                    Content="🎲 模拟工人将 Y2 放歪"
                    Foreground="White" />

                <dx:SimpleButton
                    x:Name="BtnClearLines"
                    Height="30"
                    Background="#FF546E7A"
                    Click="BtnClearLines_Click"
                    Content="🧹 清空画板与胶路"
                    Foreground="White" />

            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </Grid>
</UserControl>