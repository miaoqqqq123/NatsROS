<UserControl
    x:Class="NatsROS.Dashboard.Plugins.ProjectManager.ProjectManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
    Background="#1E1E1E">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <!--  左侧：已有的工程文件列表  -->
        <dxlc:LayoutGroup
            Grid.Column="0"
            Header="📦 本地工程包仓库 (Project Solutions)"
            View="GroupBox">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <dx:SimpleButton
                    Width="100"
                    Height="30"
                    Margin="0,0,0,10"
                    HorizontalAlignment="Left"
                    Click="BtnRefresh_Click"
                    Content="🔄 刷新仓库" />

                <dxg:GridControl
                    x:Name="GridProjects"
                    Grid.Row="1"
                    AutoGenerateColumns="None"
                    SelectedItemChanged="GridProjects_SelectedItemChanged">
                    <dxg:GridControl.View>
                        <dxg:TableView
                            AllowEditing="False"
                            AlternateRowBackground="#2D2D30"
                            NavigationStyle="Row"
                            RowMinHeight="40"
                            ShowGroupPanel="False" />
                    </dxg:GridControl.View>
                    <dxg:GridColumn
                        Width="*"
                        FieldName="FileName"
                        Header="工程包名称 (.natsros)">
                        <dxg:GridColumn.CellStyle>
                            <Style TargetType="dxg:LightweightCellEditor">
                                <Setter Property="FontSize" Value="16" />
                                <Setter Property="Foreground" Value="#FF00BCD4" />
                            </Style>
                        </dxg:GridColumn.CellStyle>
                    </dxg:GridColumn>
                    <dxg:GridColumn
                        Width="100"
                        FieldName="FileSizeMb"
                        Header="大小 (MB)" />
                    <dxg:GridColumn
                        Width="160"
                        FieldName="LastModified"
                        Header="最后修改时间" />
                </dxg:GridControl>
            </Grid>
        </dxlc:LayoutGroup>

        <!--  右侧：工程操作面板  -->
        <dxlc:LayoutGroup
            Grid.Column="2"
            Header="⚙️ 工作区控制 (Workspace Control)"
            Orientation="Vertical"
            View="GroupBox">

            <TextBlock
                Margin="0,10,0,10"
                FontSize="14"
                Foreground="LightGray"
                Text="第一步：将当前工作区打包" />
            <dxe:TextEdit
                x:Name="TxtNewProjectName"
                Height="40"
                Margin="0,0,0,10"
                FontSize="16"
                NullText="输入新工程名 (如 Apple_V1)" />
            <dx:SimpleButton
                x:Name="BtnBackupCurrent"
                Height="45"
                Background="#FF00838F"
                Click="BtnBackupCurrent_Click"
                Content="💾 将当前运行配置打包备份"
                FontSize="14"
                FontWeight="Bold"
                Foreground="White" />

            <Separator Margin="0,30,0,20" Background="#444" />

            <TextBlock
                Margin="0,0,0,10"
                FontSize="14"
                Foreground="LightGray"
                Text="第二步：热切换生产工程" />
            <TextBlock
                x:Name="TxtSelectedProject"
                Margin="0,0,0,15"
                FontSize="16"
                FontWeight="Bold"
                Foreground="Orange"
                Text="未选择工程"
                TextWrapping="Wrap" />

            <dx:SimpleButton
                x:Name="BtnLoadProject"
                Height="50"
                Background="#FF2E7D32"
                Click="BtnLoadProject_Click"
                Content="🚀 一键解压并热加载该工程"
                FontSize="16"
                FontWeight="Bold"
                Foreground="White"
                IsEnabled="False" />

            <TextBlock
                Margin="0,15,0,0"
                Foreground="#FFC62828"
                Text="警告：加载新工程将覆盖 CurrentWorkspace 下的所有配置与行为树！"
                TextWrapping="Wrap" />

            <Separator Margin="0,30,0,15" Background="#444" />
            <TextBlock
                Margin="0,0,0,10"
                FontSize="14"
                Foreground="LightGray"
                Text="开发者与实施选项 (Developer Options)" />

            <dxe:ToggleSwitch
                x:Name="TogDebugMode"
                Checked="TogDebugMode_CheckedChanged"
                Content="🐛 开启后台进程调试终端 (需重启)"
                FontSize="14"
                FontWeight="Bold"
                Foreground="Orange"
                Unchecked="TogDebugMode_CheckedChanged" />
        </dxlc:LayoutGroup>
    </Grid>
</UserControl>