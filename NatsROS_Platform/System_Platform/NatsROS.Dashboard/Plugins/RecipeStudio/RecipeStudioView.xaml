<UserControl
    x:Class="NatsROS.Dashboard.Plugins.RecipeStudio.RecipeStudioView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
    xmlns:security="clr-namespace:NatsROS.Dashboard.Security"
    Background="#1E1E1E">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  左侧：全量配方库  -->
        <dxlc:LayoutGroup
            Grid.Column="0"
            Header="📚 中央配方库 (Master Recipes)"
            View="GroupBox">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <dx:SimpleButton
                    Height="30"
                    Margin="0,0,0,5"
                    Click="BtnRefresh_Click"
                    Content="🔄 刷新库" />
                <dxg:GridControl
                    x:Name="GridRecipes"
                    Grid.Row="1"
                    AutoGenerateColumns="None"
                    SelectedItemChanged="GridRecipes_SelectedItemChanged">
                    <dxg:GridControl.View>
                        <dxg:TableView
                            AllowEditing="False"
                            NavigationStyle="Row"
                            ShowGroupPanel="False" />
                    </dxg:GridControl.View>
                    <dxg:GridColumn
                        Width="150"
                        FieldName="RecipeId"
                        Header="配方代码" />
                    <dxg:GridColumn
                        Width="100"
                        FieldName="State"
                        Header="状态" />
                    <dxg:GridColumn
                        Width="60"
                        FieldName="Version"
                        Header="版本" />
                </dxg:GridControl>
            </Grid>
        </dxlc:LayoutGroup>

        <GridSplitter
            Grid.Column="1"
            HorizontalAlignment="Stretch"
            Background="Transparent" />

        <!--  右侧：配方编辑器与合规审计  -->
        <dxlc:LayoutControl Grid.Column="2" Padding="0">
            <dxlc:LayoutGroup Orientation="Vertical">

                <!--  顶部：控制区  -->
                <dxlc:LayoutGroup Margin="0,0,0,10" Orientation="Horizontal">
                    <dx:SimpleButton
                        x:Name="BtnNew"
                        Width="80"
                        Height="35"
                        Background="#FF00838F"
                        Click="BtnNew_Click"
                        Content="📄 新建"
                        Foreground="White" />

                    <!--  【新增】：解决问题 1 和 3（升版与复制差异化产品）  -->
                    <dx:SimpleButton
                        x:Name="BtnClone"
                        Width="140"
                        Height="35"
                        Margin="10,0,0,0"
                        Background="#FF0277BD"
                        Click="BtnClone_Click"
                        Content="👯 复制/升版 (Clone)"
                        Foreground="White" />

                    <dx:SimpleButton
                        x:Name="BtnSave"
                        Width="100"
                        Height="35"
                        Margin="10,0,0,0"
                        Background="#FF37474F"
                        Click="BtnSave_Click"
                        Content="💾 保存草稿"
                        Foreground="White" />
                    <dxe:TextEdit
                        x:Name="TxtChangeReason"
                        Width="180"
                        Height="35"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        NullText="输入修改原因 (必填)" />

                    <!--  状态流转按钮区  -->
                    <dx:SimpleButton
                        x:Name="BtnApprove"
                        Width="120"
                        Height="35"
                        Margin="20,0,0,0"
                        security:PermissionGuard.Require="Recipe.Approve"
                        Background="#FF2E7D32"
                        Click="BtnApprove_Click"
                        Content="🔐 批准 (Approve)"
                        FontWeight="Bold"
                        Foreground="White" />

                    <!--  【新增】：解决问题 4（配方作废与重新启用）  -->
                    <dx:SimpleButton
                        x:Name="BtnObsolete"
                        Width="120"
                        Height="35"
                        Margin="10,0,0,0"
                        Background="#FFC62828"
                        Click="BtnObsolete_Click"
                        Content="🗑️ 作废 (Obsolete)"
                        Foreground="White" />
                    <dx:SimpleButton
                        x:Name="BtnToDraft"
                        Width="140"
                        Height="35"
                        Margin="10,0,0,0"
                        Background="#FFEF6C00"
                        Click="BtnToDraft_Click"
                        Content="↩️ 退回草稿 (Re-Draft)"
                        Foreground="White" />
                </dxlc:LayoutGroup>

                <!--  中间：头信息与公式  -->
                <dxlc:LayoutGroup
                    Height="250"
                    ItemLabelsAlignment="Local"
                    Orientation="Horizontal">
                    <dxlc:LayoutGroup
                        Width="300"
                        Header="📑 基础属性 (Header)"
                        Orientation="Vertical"
                        View="GroupBox">
                        <dxlc:LayoutItem Label="配方代码 (ID):">
                            <dxe:TextEdit x:Name="TxtId" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="产品名称:">
                            <dxe:TextEdit x:Name="TxtName" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="版本号:">
                            <dxe:TextEdit x:Name="TxtVersion" />
                        </dxlc:LayoutItem>
                        <dxlc:LayoutItem Label="绑定的工艺树:">
                            <dxe:TextEdit x:Name="TxtTree" Text="SelfHealingTree.xml" />
                        </dxlc:LayoutItem>
                    </dxlc:LayoutGroup>

                    <dxlc:LayoutGroup
                        Margin="10,0,0,0"
                        Header="⚙️ 工艺参数 (Formula)"
                        View="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Margin="0,0,0,5" Orientation="Horizontal">
                                <dx:SimpleButton
                                    Width="100"
                                    Height="25"
                                    Click="BtnAddParam_Click"
                                    Content="➕ 添加参数" />
                                <dx:SimpleButton
                                    Width="100"
                                    Height="25"
                                    Margin="5,0,0,0"
                                    Click="BtnDelParam_Click"
                                    Content="➖ 删除参数" />
                            </StackPanel>
                            <dxg:GridControl
                                x:Name="GridParams"
                                Grid.Row="1"
                                AutoGenerateColumns="None">
                                <dxg:GridControl.View>
                                    <dxg:TableView ShowGroupPanel="False" />
                                </dxg:GridControl.View>
                                <dxg:GridColumn FieldName="Key" Header="参数名 (Key)" />
                                <dxg:GridColumn FieldName="Value" Header="设定值 (Value)" />
                            </dxg:GridControl>
                        </Grid>
                    </dxlc:LayoutGroup>
                </dxlc:LayoutGroup>

                <!--  底部：FDA 审计追踪黑匣子  -->
                <dxlc:LayoutGroup
                    Margin="0,10,0,0"
                    Header="🛡️ 审计追踪记录 (Audit Trail - 21 CFR Part 11)"
                    View="GroupBox">
                    <dxg:GridControl x:Name="GridAudits" AutoGenerateColumns="None">
                        <dxg:GridControl.View>
                            <dxg:TableView
                                AllowEditing="False"
                                AlternateRowBackground="#2D2D30"
                                ShowGroupPanel="False" />
                        </dxg:GridControl.View>
                        <dxg:GridColumn
                            Width="200"
                            FieldName="FormattedTime"
                            Header="操作时间" />
                        <dxg:GridColumn
                            Width="120"
                            FieldName="Operator"
                            Header="操作人" />
                        <dxg:GridColumn
                            Width="100"
                            FieldName="Action"
                            Header="动作" />
                        <dxg:GridColumn FieldName="Details" Header="变更详情" />
                    </dxg:GridControl>
                </dxlc:LayoutGroup>

            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </Grid>
</UserControl>