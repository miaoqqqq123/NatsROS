<UserControl
    x:Class="NatsROS.Dashboard.Plugins.RecipeStudio.RecipeStudioView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
    xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
    xmlns:security="clr-namespace:NatsROS.Dashboard.Security">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <dxb:BarManager Grid.Row="0">
            <!--  DevExpress 工具栏菜单定义（干净纯粹的动作按钮栏）  -->
            <dxb:BarManager.Bars>
                <dxb:Bar
                    AllowCustomizationMenu="False"
                    AllowQuickCustomization="False"
                    AllowRemove="False"
                    BorderThickness="5,5,5,0"
                    Caption="配方操作工具栏"
                    CornerRadius="5,5,5,5"
                    GlyphSize="Large"
                    ShowDragWidget="False"
                    ShowSizeGrip="False">
                    <dxb:Bar.ItemLinks>
                        <!--  编辑操作组  -->
                        <dxb:BarButtonItemLink BarItemName="BtnNew" />
                        <dxb:BarButtonItemLink BarItemName="BtnClone" />
                        <dxb:BarButtonItemLink BarItemName="BtnSave" />

                        <dxb:BarItemLinkSeparator />

                        <!--  状态与生命周期组  -->
                        <dxb:BarButtonItemLink BarItemName="BtnApprove" />
                        <dxb:BarButtonItemLink BarItemName="BtnActivate" />

                        <dxb:BarItemLinkSeparator />

                        <!--  状态与生命周期组  -->
                        <dxb:BarButtonItemLink BarItemName="BtnToDraft" />
                        <dxb:BarButtonItemLink BarItemName="BtnObsolete" />

                        <dxb:BarItemLinkSeparator />

                        <!--  危险/低频操作收纳菜单  -->
                        <dxb:BarSubItemLink BarItemName="MenuMoreActions" />
                    </dxb:Bar.ItemLinks>
                </dxb:Bar>
            </dxb:BarManager.Bars>

            <!--  工具栏条目定义  -->
            <dxb:BarManager.Items>
                <dxb:BarButtonItem
                    x:Name="BtnNew"
                    BarItemDisplayMode="ContentAndGlyph"
                    Content="新建"
                    Glyph="{dx:DXImage 'SvgImages/Actions/New.svg'}"
                    ItemClick="BtnNew_Click" />
                <dxb:BarButtonItem
                    x:Name="BtnClone"
                    BarItemDisplayMode="ContentAndGlyph"
                    Content="复制/升版"
                    Glyph="{dx:DXImage 'SvgImages/Edit/Copy.svg'}"
                    ItemClick="BtnClone_Click" />
                <dxb:BarButtonItem
                    x:Name="BtnSave"
                    BarItemDisplayMode="ContentAndGlyph"
                    Content="保存草稿"
                    Glyph="{dx:DXImage 'SvgImages/Save/Save.svg'}"
                    ItemClick="BtnSave_Click" />

                <dxb:BarButtonItem
                    x:Name="BtnApprove"
                    BarItemDisplayMode="ContentAndGlyph"
                    Content="批准 (Approve)"
                    Glyph="{dx:DXImage 'SvgImages/DiagramIcons/SelectTool_PanTool.svg'}"
                    ItemClick="BtnApprove_Click" />
                <dxb:BarButtonItem
                    x:Name="BtnActivate"
                    BarItemDisplayMode="ContentAndGlyph"
                    Content="设为生产配方"
                    Glyph="{dx:DXImage 'SvgImages/Icon Builder/Business_Diagram.svg'}"
                    ItemClick="BtnActivate_Click" />

                <!--  下拉二级菜单  -->
                <dxb:BarSubItem
                    x:Name="MenuMoreActions"
                    BarItemDisplayMode="ContentAndGlyph"
                    Content="更多操作..."
                    Glyph="{dx:DXImage 'SvgImages/Setup/Properties.svg'}" />

                <dxb:BarButtonItem
                    x:Name="BtnToDraft"
                    BarItemDisplayMode="ContentAndGlyph"
                    Content="退回草稿 (Re-Draft)"
                    Glyph="{dx:DXImage 'SvgImages/Dashboards/Undo.svg'}"
                    ItemClick="BtnToDraft_Click" />
                <dxb:BarButtonItem
                    x:Name="BtnObsolete"
                    BarItemDisplayMode="ContentAndGlyph"
                    Content="作废 (Obsolete)"
                    Glyph="{dx:DXImage 'SvgImages/Icon Builder/Actions_DeleteCircled.svg'}"
                    ItemClick="BtnObsolete_Click" />
            </dxb:BarManager.Items>


        </dxb:BarManager>

        <!--  全局统一 DockLayoutManager 布局  -->
        <Grid Grid.Row="1" Margin="4">
            <!--  主体区域：统一托管中央配方库与工作区  -->
            <dxdo:DockLayoutManager>
                <dxdo:LayoutGroup Orientation="Horizontal">

                    <!--  左侧：中央配方库 Panel  -->
                    <dxdo:LayoutPanel
                        MinWidth="240"
                        AllowClose="False"
                        Caption="📚 中央配方库 (Master Recipes)"
                        ItemWidth="320"
                        ShowCloseButton="False"
                        ShowPinButton="False">
                        <Grid Margin="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <dx:SimpleButton
                                Height="28"
                                Margin="0,0,0,6"
                                Click="BtnRefresh_Click"
                                Content="🔄 刷新库" />

                            <dxg:GridControl
                                x:Name="GridRecipes"
                                Grid.Row="1"
                                AutoGenerateColumns="None"
                                SelectedItemChanged="GridRecipes_SelectedItemChanged">
                                <dxg:GridControl.View>
                                    <dxg:TableView
                                        AllowEditing="False"
                                        NavigationStyle="Row"
                                        ShowGroupPanel="False" />
                                </dxg:GridControl.View>
                                <dxg:GridColumn
                                    Width="1.5*"
                                    FieldName="RecipeId"
                                    Header="配方代码" />
                                <dxg:GridColumn
                                    Width="*"
                                    FieldName="State"
                                    Header="状态" />
                                <dxg:GridColumn
                                    Width="55"
                                    FieldName="Version"
                                    Header="版本" />
                            </dxg:GridControl>
                        </Grid>
                    </dxdo:LayoutPanel>

                    <!--  右侧：工作区布局组  -->
                    <dxdo:LayoutGroup ItemWidth="*" Orientation="Vertical">

                        <!--  中部：属性与参数区域（并排分布）  -->
                        <dxdo:LayoutGroup ItemHeight="1*">
                            <!--  基础属性表单：已调整为包含修改原因  -->
                            <dxdo:LayoutPanel
                                AllowClose="False"
                                Caption="📑 基础属性 (Header)"
                                ShowCloseButton="False"
                                ShowPinButton="False">
                                <dxlc:LayoutControl ItemSpace="6" Orientation="Vertical">
                                    <dxlc:LayoutItem Label="配方代码 (ID):">
                                        <dxe:TextEdit x:Name="TxtId" />
                                    </dxlc:LayoutItem>
                                    <dxlc:LayoutItem Label="产品名称:">
                                        <dxe:TextEdit x:Name="TxtName" />
                                    </dxlc:LayoutItem>
                                    <dxlc:LayoutItem Label="版本号:">
                                        <dxe:TextEdit x:Name="TxtVersion" IsReadOnly="True" />
                                    </dxlc:LayoutItem>

                                    <!--  【变更亮点】：替换为修改原因，采用 Memo/多行或带提示的文本框  -->
                                    <dxlc:LayoutItem VerticalAlignment="Stretch" Label="修改原因 (必填):">
                                        <dxe:TextEdit
                                            x:Name="TxtChangeReason"
                                            MinHeight="60"
                                            VerticalContentAlignment="Top"
                                            AcceptsReturn="True"
                                            NullText="请输入本次变更/版本的修改原因..." />
                                    </dxlc:LayoutItem>
                                </dxlc:LayoutControl>
                            </dxdo:LayoutPanel>

                            <!--  工艺参数表格  -->
                            <dxdo:LayoutPanel
                                AllowClose="False"
                                Caption="⚙️ 工艺参数 (Formula)"
                                ShowCloseButton="False"
                                ShowPinButton="False">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                                        <dx:SimpleButton
                                            Width="100"
                                            Height="24"
                                            Click="BtnAddParam_Click"
                                            Content="➕ 添加参数" />
                                        <dx:SimpleButton
                                            Width="100"
                                            Height="24"
                                            Margin="6,0,0,0"
                                            Click="BtnDelParam_Click"
                                            Content="➖ 删除参数" />
                                    </StackPanel>
                                    <dxg:GridControl
                                        x:Name="GridParams"
                                        Grid.Row="1"
                                        AutoGenerateColumns="None">
                                        <dxg:GridControl.View>
                                            <dxg:TableView ShowGroupPanel="False" />
                                        </dxg:GridControl.View>
                                        <dxg:GridColumn FieldName="Key" Header="参数名 (Key)" />
                                        <dxg:GridColumn
                                            Width="*"
                                            FieldName="Value"
                                            Header="设定值 (Value)" />
                                    </dxg:GridControl>
                                </Grid>
                            </dxdo:LayoutPanel>
                        </dxdo:LayoutGroup>

                        <!--  底部：审计追踪记录  -->
                        <dxdo:LayoutGroup ItemHeight="1.5*">
                            <dxdo:LayoutPanel
                                AllowClose="False"
                                Caption="🛡️ 审计追踪记录 (Audit Trail - 21 CFR Part 11)"
                                ShowCloseButton="False"
                                ShowPinButton="False">
                                <dxg:GridControl x:Name="GridAudits" AutoGenerateColumns="None">
                                    <dxg:GridControl.View>
                                        <dxg:TableView AllowEditing="False" ShowGroupPanel="False" />
                                    </dxg:GridControl.View>
                                    <dxg:GridColumn
                                        Width="150"
                                        FieldName="FormattedTime"
                                        Header="操作时间" />
                                    <dxg:GridColumn
                                        Width="100"
                                        FieldName="Operator"
                                        Header="操作人" />
                                    <dxg:GridColumn
                                        Width="90"
                                        FieldName="Action"
                                        Header="动作" />
                                    <dxg:GridColumn
                                        Width="*"
                                        FieldName="Details"
                                        Header="变更详情" />
                                </dxg:GridControl>
                            </dxdo:LayoutPanel>
                        </dxdo:LayoutGroup>

                    </dxdo:LayoutGroup>
                </dxdo:LayoutGroup>
            </dxdo:DockLayoutManager>
        </Grid>
    </Grid>

</UserControl>