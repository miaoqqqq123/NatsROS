<UserControl
    x:Class="NatsROS.Dashboard.Plugins.BehaviorTreeEditor.BtEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
    xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxprg="http://schemas.devexpress.com/winfx/2008/xaml/propertygrid"
    Background="Transparent">

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  顶层统一工具栏 (BarManager)  -->
        <dxb:BarManager Grid.Row="0">
            <dxb:BarManager.Bars>
                <dxb:Bar
                    AllowCustomizationMenu="False"
                    AllowQuickCustomization="False"
                    AllowRemove="False"
                    BorderThickness="5,5,5,0"
                    Caption="行为树操作工具栏"
                    CornerRadius="5,5,5,5"
                    GlyphSize="Large"
                    ShowDragWidget="False"
                    ShowSizeGrip="False">
                    <dxb:Bar.ItemLinks>
                        <!--  文件操作组  -->
                        <dxb:BarButtonItemLink BarItemName="BtnLoadXml" />
                        <dxb:BarButtonItemLink BarItemName="BtnSaveXml" />
                        <dxb:BarItemLinkSeparator />

                        <!--  视图控制组  -->
                        <dxb:BarButtonItemLink BarItemName="BtnExpandAll" />
                        <dxb:BarButtonItemLink BarItemName="BtnCollapseAll" />
                        <dxb:BarItemLinkSeparator />

                        <!--  下发控制组  -->
                        <dxb:BarEditItemLink BarItemName="EditTargetBrain" />
                        <dxb:BarButtonItemLink BarItemName="BtnDeploy" />
                    </dxb:Bar.ItemLinks>
                </dxb:Bar>
            </dxb:BarManager.Bars>

            <dxb:BarManager.Items>
                <dxb:BarButtonItem
                    x:Name="BtnLoadXml"
                    BarItemDisplayMode="ContentAndGlyph"
                    Content="📂 导入配方"
                    Glyph="{dx:DXImage 'SvgImages/Actions/Open.svg'}"
                    ItemClick="BtnLoadXml_Click" />
                <dxb:BarButtonItem
                    x:Name="BtnSaveXml"
                    BarItemDisplayMode="ContentAndGlyph"
                    Content="💾 导出 XML"
                    Glyph="{dx:DXImage 'SvgImages/Save/Save.svg'}"
                    ItemClick="BtnSaveXml_Click" />

                <dxb:BarButtonItem
                    x:Name="BtnExpandAll"
                    BarItemDisplayMode="ContentAndGlyph"
                    Content="🔽 展开全部"
                    ItemClick="BtnExpandAll_Click" />
                <dxb:BarButtonItem
                    x:Name="BtnCollapseAll"
                    BarItemDisplayMode="ContentAndGlyph"
                    Content="🔼 折叠全部"
                    ItemClick="BtnCollapseAll_Click" />

                <dxb:BarEditItem
                    x:Name="EditTargetBrain"
                    Content="目标大脑:"
                    EditValue="brain_dispenser"
                    EditWidth="150">
                    <dxb:BarEditItem.EditSettings>
                        <dxe:TextEditSettings />
                    </dxb:BarEditItem.EditSettings>
                    <!--  使用 EditStyle 设置编辑器内部文字的样式  -->
                    <dxb:BarEditItem.EditStyle>
                        <Style TargetType="dxe:TextEdit">
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="Foreground" Value="Orange" />
                            <!--  还可以根据需要添加其他字体属性  -->
                            <!-- <Setter Property="FontSize" Value="14"/> -->
                            <!-- <Setter Property="FontFamily" Value="Microsoft YaHei"/> -->
                        </Style>
                    </dxb:BarEditItem.EditStyle>
                </dxb:BarEditItem>

                <dxb:BarButtonItem
                    x:Name="BtnDeploy"
                    BarItemDisplayMode="ContentAndGlyph"
                    Content="🚀 动态热更新至大脑"
                    Foreground="DarkGreen"
                    Glyph="{dx:DXImage 'SvgImages/Icon Builder/Actions_ArrowRight.svg'}"
                    ItemClick="BtnDeploy_Click" />
            </dxb:BarManager.Items>
        </dxb:BarManager>

        <!--  全局统一 DockLayoutManager 布局  -->
        <Grid Grid.Row="1" Margin="4">
            <dxdo:DockLayoutManager>
                <dxdo:LayoutGroup Orientation="Horizontal">

                    <!--  1. 左侧：智能组件库 (带有底部描述)  -->
                    <dxdo:LayoutGroup ItemWidth="280" Orientation="Vertical">
                        <dxdo:LayoutPanel
                            AllowClose="False"
                            Caption="🛒 组件库 (选中父节点后双击)"
                            ItemHeight="5*"
                            ShowCloseButton="False"
                            ShowPinButton="False">
                            <Grid Margin="5">
                                <dxg:GridControl
                                    x:Name="GridToolbox"
                                    AutoGenerateColumns="None"
                                    MouseDoubleClick="GridToolbox_MouseDoubleClick">
                                    <dxg:GridControl.View>
                                        <dxg:TableView
                                            AllowEditing="False"
                                            NavigationStyle="Row"
                                            SearchPanelAllowFilter="True"
                                            ShowGroupPanel="True"
                                            ShowSearchPanelMode="Always" />
                                    </dxg:GridControl.View>
                                    <dxg:GridColumn
                                        FieldName="Category"
                                        GroupIndex="0"
                                        Header="分类" />
                                    <dxg:GridColumn FieldName="DisplayName" Header="节点名称" />
                                </dxg:GridControl>
                            </Grid>
                        </dxdo:LayoutPanel>

                        <!--  描述面板  -->
                        <dxdo:LayoutPanel
                            AllowClose="False"
                            Caption="描述 (Description)"
                            ShowCloseButton="False"
                            ShowPinButton="False">
                            <Grid Margin="5">
                                <StackPanel>
                                    <TextBlock
                                        Margin="0,0,0,5"
                                        FontWeight="Bold"
                                        Text="{Binding ElementName=GridToolbox, Path=SelectedItem.FullDisplayName, StringFormat='名称: {0}'}" />
                                    <TextBlock
                                        Foreground="DarkGray"
                                        Text="{Binding ElementName=GridToolbox, Path=SelectedItem.Description, StringFormat='描述: {0}'}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </dxdo:LayoutPanel>
                    </dxdo:LayoutGroup>

                    <!--  2. 中间：极速树形表格 (TreeList)  -->
                    <dxdo:LayoutPanel
                        AllowClose="False"
                        Caption="🌲 行为树编排结构 (严格同级控制)"
                        ItemWidth="*"
                        ShowCloseButton="False"
                        ShowPinButton="False">
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Margin="0,0,0,5" Orientation="Horizontal">
                                <dx:SimpleButton
                                    Width="80"
                                    Height="25"
                                    Click="BtnMoveUp_Click"
                                    Content="⬆️ 上移" />
                                <dx:SimpleButton
                                    Width="80"
                                    Height="25"
                                    Margin="5,0,0,0"
                                    Click="BtnMoveDown_Click"
                                    Content="⬇️ 下移" />
                                <dx:SimpleButton
                                    Width="80"
                                    Height="25"
                                    Margin="20,0,0,0"
                                    Click="BtnDeleteNode_Click"
                                    Content="❌ 删除"
                                    Foreground="DarkRed" />
                                <TextBlock
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Foreground="Gray"
                                    Text="提示: 双击名称可重命名。节点仅限在同级内上下移动。" />
                            </StackPanel>

                            <dxg:TreeListControl
                                x:Name="TreeListBehavior"
                                Grid.Row="1"
                                AutoGenerateColumns="None"
                                SelectedItemChanged="TreeListBehavior_SelectedItemChanged">
                                <dxg:TreeListControl.View>
                                    <!--  关闭拖拽，开启重命名，防止误操作  -->
                                    <dxg:TreeListView
                                        x:Name="TreeListView"
                                        AllowDragDrop="False"
                                        AllowEditing="True"
                                        AutoExpandAllNodes="True"
                                        ChildNodesPath="Children"
                                        EditorShowMode="MouseUpFocused"
                                        NavigationStyle="Cell"
                                        TreeDerivationMode="ChildNodesSelector" />
                                </dxg:TreeListControl.View>

                                <dxg:TreeListColumn
                                    Width="250"
                                    AllowEditing="True"
                                    FieldName="Name"
                                    Header="节点名称 (Name)">
                                    <dxg:TreeListColumn.CellStyle>
                                        <Style TargetType="dxg:LightweightCellEditor">
                                            <Setter Property="TextElement.FontWeight" Value="Bold" />
                                            <Setter Property="TextElement.FontSize" Value="12" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RowData.Row.NodeType}" Value="Sequence">
                                                    <Setter Property="Foreground" Value="#4FC3F7" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RowData.Row.NodeType}" Value="Action">
                                                    <Setter Property="Foreground" Value="#81C784" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RowData.Row.NodeType}" Value="Decorator">
                                                    <Setter Property="Foreground" Value="#FFB74D" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RowData.Row.NodeType}" Value="Root">
                                                    <Setter Property="Foreground" Value="#FFF59D" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </dxg:TreeListColumn.CellStyle>
                                </dxg:TreeListColumn>
                                <dxg:TreeListColumn
                                    Width="100"
                                    AllowEditing="False"
                                    FieldName="NodeType"
                                    Header="类型 (Type)" />
                                <dxg:TreeListColumn
                                    Width="*"
                                    AllowEditing="False"
                                    FieldName="Summary"
                                    Header="参数预览 (Parameters Summary)" />
                            </dxg:TreeListControl>
                        </Grid>
                    </dxdo:LayoutPanel>

                    <!--  3. 右侧：参数配置器  -->
                    <dxdo:LayoutPanel
                        AllowClose="False"
                        Caption="⚙️ 节点参数配置 (Properties)"
                        ItemWidth="350"
                        ShowCloseButton="False"
                        ShowPinButton="False">
                        <!--  【清爽干净】：去掉了之前繁杂的 PropertyDefinitions，依靠 C# 后台注入黑魔法  -->
                        <dxprg:PropertyGridControl
                            x:Name="PropGridNode"
                            CellValueChanged="PropGridNode_CellValueChanged"
                            ExpandCategoriesWhenSelectedObjectChanged="True"
                            ShowDescriptionIn="Panel"
                            ShowSearchBox="False" />
                    </dxdo:LayoutPanel>

                </dxdo:LayoutGroup>
            </dxdo:DockLayoutManager>
        </Grid>
    </Grid>
</UserControl>