<UserControl
    x:Class="NatsROS.Dashboard.Plugins.HalConsole.HalConsoleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
    Background="#1E1E1E">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="1.5*" />
        </Grid.ColumnDefinitions>

        <!--  左侧：运动控制板 32位 IO 监控台  -->
        <dxlc:LayoutGroup
            Grid.Column="0"
            Header="🎛️ 运动控制板卡物理 IO (Motion Board I/O)"
            View="GroupBox">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    Margin="0,0,0,10"
                    Foreground="Gray"
                    Text="点击引脚按钮可强制置位/复位 (强制输出至硬件)" />

                <!--  使用 ItemsControl 动态渲染 32 个引脚  -->
                <ItemsControl x:Name="IoItemsControl" Grid.Row="1">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!--  IO 按钮  -->
                            <Button
                                Width="50"
                                Height="50"
                                Margin="5"
                                Background="{Binding PinColor}"
                                Click="BtnIoPin_Click"
                                Content="{Binding PinName}"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="White"
                                Tag="{Binding PinId}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="#555"
                                            BorderThickness="1"
                                            CornerRadius="5">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </dxlc:LayoutGroup>

        <GridSplitter
            Grid.Column="1"
            HorizontalAlignment="Stretch"
            Background="Transparent" />

        <!--  右侧：外围设备强制测试台  -->
        <dxlc:LayoutControl Grid.Column="2" Padding="0">
            <dxlc:LayoutGroup Orientation="Vertical">

                <!--  1. 三色灯测试  -->
                <dxlc:LayoutGroup
                    Height="150"
                    Header="🚥 工业塔灯控制 (Tower Light)"
                    Orientation="Vertical"
                    View="GroupBox">
                    <StackPanel
                        Margin="0,15,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <!--  红灯  -->
                        <dxe:ComboBoxEdit
                            x:Name="CboRed"
                            Width="100"
                            Margin="5"
                            IsTextEditable="False"
                            SelectedIndex="0">
                            <dxe:ComboBoxEditItem Content="熄灭 (Off)" />
                            <dxe:ComboBoxEditItem Content="常亮 (Solid)" />
                            <dxe:ComboBoxEditItem Content="闪烁 (Blink)" />
                        </dxe:ComboBoxEdit>
                        <!--  黄灯  -->
                        <dxe:ComboBoxEdit
                            x:Name="CboYellow"
                            Width="100"
                            Margin="5"
                            IsTextEditable="False"
                            SelectedIndex="0">
                            <dxe:ComboBoxEditItem Content="熄灭 (Off)" />
                            <dxe:ComboBoxEditItem Content="常亮 (Solid)" />
                            <dxe:ComboBoxEditItem Content="闪烁 (Blink)" />
                        </dxe:ComboBoxEdit>
                        <!--  绿灯  -->
                        <dxe:ComboBoxEdit
                            x:Name="CboGreen"
                            Width="100"
                            Margin="5"
                            IsTextEditable="False"
                            SelectedIndex="0">
                            <dxe:ComboBoxEditItem Content="熄灭 (Off)" />
                            <dxe:ComboBoxEditItem Content="常亮 (Solid)" />
                            <dxe:ComboBoxEditItem Content="闪烁 (Blink)" />
                        </dxe:ComboBoxEdit>
                    </StackPanel>
                    <dx:SimpleButton
                        Height="35"
                        Margin="5,10,5,0"
                        Background="#FF37474F"
                        Click="BtnSetLight_Click"
                        Content="🚀 立即下发塔灯状态"
                        Foreground="White" />
                </dxlc:LayoutGroup>

                <!--  2. 点胶阀测试  -->
                <dxlc:LayoutGroup
                    Height="120"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Stretch"
                    Header="💧 精密点胶阀测试 (Dispenser Valve)"
                    View="GroupBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <dx:SimpleButton
                            x:Name="BtnValveOpen"
                            Grid.Column="0"
                            Width="150"
                            Height="45"
                            Margin="10"
                            Background="#FF2E7D32"
                            Click="BtnValveOpen_Click"
                            Content="🟢 强制开胶 (OPEN)"
                            FontWeight="Bold"
                            Foreground="White" />
                        <dx:SimpleButton
                            x:Name="BtnValveClose"
                            Grid.Column="1"
                            Width="150"
                            Height="45"
                            Margin="10"
                            Background="#FFC62828"
                            Click="BtnValveClose_Click"
                            Content="🔴 强制断胶 (CLOSE)"
                            FontWeight="Bold"
                            Foreground="White" />
                    </Grid>
                </dxlc:LayoutGroup>

                <!--  3. 扫码枪测试  -->
                <dxlc:LayoutGroup
                    Margin="0,10,0,0"
                    Header="🔍 基恩士扫码枪测试 (Scanner)"
                    View="GroupBox">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <dx:SimpleButton
                            x:Name="BtnTriggerScan"
                            Grid.Row="0"
                            Height="45"
                            Background="#FF0277BD"
                            Click="BtnTriggerScan_Click"
                            Content="🔦 软触发扫码 (Software Trigger)"
                            FontWeight="Bold"
                            Foreground="White" />

                        <TextBlock
                            Grid.Row="1"
                            Margin="0,15,0,0"
                            Foreground="Gray"
                            Text="扫码结果:" />
                        <dxe:TextEdit
                            x:Name="TxtScanResult"
                            Grid.Row="1"
                            Height="40"
                            Margin="0,35,0,0"
                            HorizontalContentAlignment="Center"
                            Background="#2D2D30"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="LimeGreen"
                            IsReadOnly="True" />
                    </Grid>
                </dxlc:LayoutGroup>

            </dxlc:LayoutGroup>
        </dxlc:LayoutControl>
    </Grid>
</UserControl>