<UserControl
    x:Class="NatsROS.Dashboard.Plugins.BehaviorTree.BehaviorTreeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxdiag="http://schemas.devexpress.com/winfx/2008/xaml/diagram"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <dxlc:LayoutControl Padding="0">
        <dxlc:LayoutGroup
            Header="🧠 行为树实时脑电图 (Live Behavior Tree)"
            Orientation="Vertical"
            View="GroupBox">

            <!-- ========================================== -->
            <!-- 【重构】：频道切换与巨型操作台组合 -->
            <!-- ========================================== -->
            <dxlc:LayoutGroup Height="50" Margin="0,0,0,10" Orientation="Horizontal">
                <!-- 1. 监听目标选择 -->
                <TextBlock Margin="5,0,10,0" VerticalAlignment="Center" Foreground="LightGray" Text="🎯 目标大脑:" FontSize="14" FontWeight="Bold"/>
                <dxe:ComboBoxEdit x:Name="CboBrainNode" Width="200" IsTextEditable="True" NullText="如: brain_dispenser" FontSize="16" VerticalContentAlignment="Center">
                    <dxe:ComboBoxEditItem Content="brain_dispenser" />
                    <dxe:ComboBoxEditItem Content="brain_y1" />
                    <dxe:ComboBoxEditItem Content="brain_y2" />
                </dxe:ComboBoxEdit>
                <dx:SimpleButton x:Name="BtnMonitor" Width="100" Margin="10,0,0,0" Background="#FF00838F" Foreground="White" FontWeight="Bold" Content="📡 连线" Click="BtnMonitor_Click" />

                <!-- 分割线 -->
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="20,5" />

                <!-- 2. 动态大脑控制台 (Context-Aware Control Panel) -->
                <dx:SimpleButton x:Name="BtnStart" Width="120" Margin="0,0,10,0" 
                                 Background="#FF2E7D32" Foreground="White" FontWeight="Black" FontSize="16"
                                 Content="▶ 启动 (Start)" Click="BtnStart_Click" />

                <dx:SimpleButton x:Name="BtnPause" Width="120" Margin="0,0,10,0" 
                                 Background="#FFF57C00" Foreground="White" FontWeight="Black" FontSize="16"
                                 Content="⏸ 暂停 (Pause)" Click="BtnPause_Click" />

                <dx:SimpleButton x:Name="BtnResume" Width="120" Margin="0,0,10,0" 
                                 Background="#FF0288D1" Foreground="White" FontWeight="Black" FontSize="16"
                                 Content="⏯ 恢复 (Resume)" Click="BtnResume_Click" />

                <dx:SimpleButton x:Name="BtnStop" Width="120" Margin="0,0,10,0" 
                                 Background="#FFC62828" Foreground="White" FontWeight="Black" FontSize="16"
                                 Content="🛑 急停 (Stop)" Click="BtnStop_Click" />
            </dxlc:LayoutGroup>

            <!-- 行为树是从上往下画的树状图 -->
            <dxdiag:DiagramControl x:Name="DiagramTree" LineJumpSize="0,0" ShowGrid="False" ShowPageBreaks="False" ShowRulers="False" />
        </dxlc:LayoutGroup>
    </dxlc:LayoutControl>

</UserControl>
