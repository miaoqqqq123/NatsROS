<UserControl
    x:Class="NatsROS.Dashboard.Plugins.SecurityStudio.SecurityStudioView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
    xmlns:sec="clr-namespace:NatsROS.Dashboard.Security"
    sec:PermissionGuard.Require="Security.Manage"
    Background="#1E1E1E">
    <!--  上面这行是核心！如果登录的人没有 Security.Manage 权限，整个界面自动变灰禁用！  -->

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="1.5*" />
        </Grid.ColumnDefinitions>

        <!--  左侧：用户账号管理  -->
        <dxlc:LayoutGroup
            Grid.Column="0"
            Header="👥 员工账号管理 (Users)"
            Orientation="Vertical"
            View="GroupBox">
            <dxlc:LayoutGroup
                Height="35"
                Margin="0,0,0,10"
                Orientation="Horizontal">
                <dx:SimpleButton
                    x:Name="BtnNewUser"
                    Width="100"
                    Background="#FF00838F"
                    Click="BtnNewUser_Click"
                    Content="➕ 新增用户"
                    Foreground="White" />
                <dx:SimpleButton
                    x:Name="BtnSaveUser"
                    Width="80"
                    Margin="10,0,0,0"
                    Background="#FF2E7D32"
                    Click="BtnSaveUser_Click"
                    Content="💾 保存"
                    Foreground="White" />
                <dx:SimpleButton
                    x:Name="BtnDelUser"
                    Width="80"
                    Margin="10,0,0,0"
                    Background="#FFC62828"
                    Click="BtnDelUser_Click"
                    Content="❌ 删除"
                    Foreground="White" />
            </dxlc:LayoutGroup>

            <dxg:GridControl
                x:Name="GridUsers"
                Height="200"
                AutoGenerateColumns="None"
                SelectedItemChanged="GridUsers_SelectedItemChanged">
                <dxg:GridControl.View>
                    <dxg:TableView
                        AllowEditing="False"
                        NavigationStyle="Row"
                        ShowGroupPanel="False" />
                </dxg:GridControl.View>
                <dxg:GridColumn FieldName="Username" Header="登录账号" />
                <dxg:GridColumn FieldName="DisplayName" Header="姓名" />
                <dxg:GridColumn FieldName="Role" Header="所属角色" />
            </dxg:GridControl>

            <dxlc:LayoutGroup
                Margin="0,10,0,0"
                Header="账号编辑"
                Orientation="Vertical"
                View="GroupBox">
                <dxlc:LayoutItem Label="登录账号:">
                    <dxe:TextEdit x:Name="TxtUsername" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="真实姓名:">
                    <dxe:TextEdit x:Name="TxtDisplayName" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="所属角色:">
                    <dxe:ComboBoxEdit x:Name="CboUserRole" IsTextEditable="False" />
                </dxlc:LayoutItem>
                <dxlc:LayoutItem Label="重置密码:">
                    <dxe:PasswordBoxEdit x:Name="TxtNewPassword" NullText="不修改请留空" />
                </dxlc:LayoutItem>
            </dxlc:LayoutGroup>
        </dxlc:LayoutGroup>

        <GridSplitter
            Grid.Column="1"
            HorizontalAlignment="Stretch"
            Background="Transparent" />

        <!--  右侧：角色权限点矩阵  -->
        <dxlc:LayoutGroup
            Grid.Column="2"
            Header="🔐 角色与权限分配矩阵 (Roles &amp; Permissions)"
            Orientation="Vertical"
            View="GroupBox">
            <dxlc:LayoutGroup
                Height="35"
                Margin="0,0,0,10"
                Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    Foreground="LightGray"
                    Text="选择角色: " />
                <dxe:ComboBoxEdit
                    x:Name="CboRoleSelect"
                    Width="200"
                    IsTextEditable="True"
                    SelectedIndexChanged="CboRoleSelect_SelectedIndexChanged" />
                <dx:SimpleButton
                    x:Name="BtnSaveRole"
                    Width="150"
                    Margin="20,0,0,0"
                    Background="#FF2E7D32"
                    Click="BtnSaveRole_Click"
                    Content="💾 保存权限配置"
                    FontWeight="Bold"
                    Foreground="White" />
                <dx:SimpleButton
                    x:Name="BtnDelRole"
                    Width="100"
                    Margin="10,0,0,0"
                    Background="#FFC62828"
                    Click="BtnDelRole_Click"
                    Content="❌ 移除该角色"
                    Foreground="White" />
            </dxlc:LayoutGroup>

            <!--  核心：动态权限打钩清单  -->
            <dxg:GridControl x:Name="GridPermissions" AutoGenerateColumns="None">
                <dxg:GridControl.View>
                    <!--  开启按 Category 分组  -->
                    <dxg:TableView NavigationStyle="Cell" ShowGroupPanel="False" />
                </dxg:GridControl.View>
                <dxg:GridColumn
                    FieldName="Category"
                    GroupIndex="0"
                    Header="模块" />
                <dxg:GridColumn
                    Width="60"
                    AllowEditing="True"
                    FieldName="IsGranted"
                    Header="授权">
                    <dxg:GridColumn.EditSettings>
                        <dxe:CheckEditSettings />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridColumn
                    Width="180"
                    AllowEditing="False"
                    FieldName="Code"
                    Header="权限特征码" />
                <dxg:GridColumn
                    Width="*"
                    AllowEditing="False"
                    FieldName="Description"
                    Header="说明描述" />
            </dxg:GridControl>
        </dxlc:LayoutGroup>
    </Grid>
</UserControl>