<UserControl
    x:Class="NatsROS.Dashboard.Plugins.PublisherCaller.PublisherCallerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
    xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
    xmlns:dxprg="http://schemas.devexpress.com/winfx/2008/xaml/propertygrid"
    Background="Transparent">

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  顶层统一工具栏 (BarManager)  -->
        <dxb:BarManager Grid.Row="0">
            <dxb:BarManager.Bars>
                <dxb:Bar
                    AllowCustomizationMenu="False"
                    AllowQuickCustomization="False"
                    AllowRemove="False"
                    BorderThickness="5,5,5,0"
                    Caption="消息与服务调试栏"
                    CornerRadius="5,5,5,5"
                    GlyphSize="Large"
                    ShowDragWidget="False"
                    ShowSizeGrip="False">
                    <dxb:Bar.ItemLinks>
                        <!--  发布组  -->
                        <dxb:BarButtonItemLink BarItemName="BtnPubOnce" />
                        <dxb:BarButtonItemLink BarItemName="BtnPubStart" />

                        <dxb:BarItemLinkSeparator />

                        <!--  调用组  -->
                        <dxb:BarButtonItemLink BarItemName="BtnCallService" />
                        <dxb:BarButtonItemLink BarItemName="BtnCancelAction" />
                    </dxb:Bar.ItemLinks>
                </dxb:Bar>
            </dxb:BarManager.Bars>

            <dxb:BarManager.Items>
                <dxb:BarButtonItem
                    x:Name="BtnPubOnce"
                    BarItemDisplayMode="ContentAndGlyph"
                    Content="发送单次消息 (Pub Once)"
                    Glyph="{dx:DXImage 'SvgImages/Icon Builder/Actions_Send.svg'}"
                    ItemClick="BtnPubOnce_Click" />
                <dxb:BarButtonItem
                    x:Name="BtnPubStart"
                    BarItemDisplayMode="ContentAndGlyph"
                    Content="▶️ 循环发送 (Pub Loop)"
                    Foreground="DarkGreen"
                    Glyph="{dx:DXImage 'SvgImages/Media/Play.svg'}"
                    ItemClick="BtnPubStart_Click" />

                <dxb:BarButtonItem
                    x:Name="BtnCallService"
                    BarItemDisplayMode="ContentAndGlyph"
                    Content="🚀 发起调用 (Call Service)"
                    Foreground="#00BCD4"
                    Glyph="{dx:DXImage 'SvgImages/Business Objects/BO_Transition.svg'}"
                    ItemClick="BtnCallService_Click" />
                <dxb:BarButtonItem
                    x:Name="BtnCancelAction"
                    BarItemDisplayMode="ContentAndGlyph"
                    Content="🛑 强行打断动作 (Cancel)"
                    Foreground="DarkRed"
                    Glyph="{dx:DXImage 'SvgImages/Icon Builder/Actions_DeleteCircled.svg'}"
                    ItemClick="BtnCancelAction_Click" />
            </dxb:BarManager.Items>
        </dxb:BarManager>

        <!--  全局统一 DockLayoutManager 布局  -->
        <Grid Grid.Row="1" Margin="4">
            <dxdo:DockLayoutManager>
                <dxdo:LayoutGroup Orientation="Horizontal">

                    <!--  1. 左侧：消息发布器 (Publisher)  -->
                    <dxdo:LayoutPanel
                        AllowClose="False"
                        Caption="📤 消息发布调试器 (Topic Publisher)"
                        ItemWidth="*"
                        ShowCloseButton="False"
                        ShowPinButton="False">
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <dxlc:LayoutControl
                                Grid.Row="0"
                                Margin="0,0,0,10"
                                Padding="0">
                                <dxlc:LayoutGroup Orientation="Vertical">
                                    <dxlc:LayoutItem Label="发布话题 (Topic):">
                                        <dxe:TextEdit x:Name="TxtPubTopic" Text="test_topic" />
                                    </dxlc:LayoutItem>
                                    <dxlc:LayoutGroup Margin="0,5,0,0" Orientation="Horizontal">
                                        <dxlc:LayoutItem Label="契约类型 (Type):">
                                            <dxe:ComboBoxEdit
                                                x:Name="CboPubType"
                                                AutoComplete="True"
                                                DisplayMember="FullName"
                                                ImmediatePopup="True"
                                                SelectedIndexChanged="CboPubType_SelectedIndexChanged" />
                                        </dxlc:LayoutItem>
                                        <dxlc:LayoutItem
                                            Width="150"
                                            Margin="10,0,0,0"
                                            Label="频率(Hz):">
                                            <dxe:SpinEdit
                                                x:Name="SpinPubHz"
                                                MaxValue="100"
                                                MinValue="0.1"
                                                Value="1" />
                                        </dxlc:LayoutItem>
                                    </dxlc:LayoutGroup>
                                </dxlc:LayoutGroup>
                            </dxlc:LayoutControl>

                            <dxlc:LayoutGroup
                                Grid.Row="1"
                                Header="📝 消息载荷构造器 (Payload Editor)"
                                View="GroupBox">
                                <dxprg:PropertyGridControl
                                    x:Name="PropGridPublisher"
                                    ExpandCategoriesWhenSelectedObjectChanged="True"
                                    ShowSearchBox="True" />
                            </dxlc:LayoutGroup>
                        </Grid>
                    </dxdo:LayoutPanel>

                    <!--  2. 右侧：服务与动作调试器 (Service/Action Caller)  -->
                    <dxdo:LayoutPanel
                        AllowClose="False"
                        Caption="🚀 服务与动作调试器 (RPC / Action Caller)"
                        ItemWidth="1.5*"
                        ShowCloseButton="False"
                        ShowPinButton="False">
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <dxlc:LayoutControl
                                Grid.Row="0"
                                Margin="0,0,0,10"
                                Padding="0">
                                <dxlc:LayoutGroup Orientation="Vertical">
                                    <dxlc:LayoutGroup Orientation="Horizontal">
                                        <dxlc:LayoutItem Label="寻址路由 (Route):">
                                            <dxe:TextEdit x:Name="TxtSrvName" Text="target_node.action" />
                                        </dxlc:LayoutItem>

                                    </dxlc:LayoutGroup>
                                    <dxlc:LayoutItem Margin="0,5,0,0" Label="契约类型 (Request / Goal):">
                                        <dxlc:LayoutGroup Orientation="Horizontal">
                                            <dxe:ComboBoxEdit
                                                x:Name="CboSrvReqType"
                                                AutoComplete="True"
                                                DisplayMember="FullName"
                                                ImmediatePopup="True"
                                                SelectedIndexChanged="CboSrvReqType_SelectedIndexChanged" />
                                            <dxlc:LayoutItem
                                                Width="150"
                                                Margin="10,0,0,0"
                                                Label="超时等待(秒):">
                                                <dxe:SpinEdit
                                                    x:Name="SpinSrvTimeout"
                                                    MaxValue="3600"
                                                    MinValue="0"
                                                    Value="3" />
                                            </dxlc:LayoutItem>
                                        </dxlc:LayoutGroup>
                                    </dxlc:LayoutItem>
                                </dxlc:LayoutGroup>
                            </dxlc:LayoutControl>

                            <dxdo:DockLayoutManager Grid.Row="1">
                                <dxdo:LayoutGroup Orientation="Horizontal">
                                    <dxdo:LayoutPanel
                                        Caption="📥 请求参数 (Request / Goal)"
                                        ShowCloseButton="False"
                                        ShowPinButton="False">
                                        <dxprg:PropertyGridControl x:Name="PropGridSrvReq" ExpandCategoriesWhenSelectedObjectChanged="True" />
                                    </dxdo:LayoutPanel>
                                    <dxdo:LayoutPanel
                                        Caption="📤 响应结果 (Response / Result)"
                                        ShowCloseButton="False"
                                        ShowPinButton="False">
                                        <dxprg:PropertyGridControl
                                            x:Name="PropGridSrvRes"
                                            ExpandCategoriesWhenSelectedObjectChanged="True"
                                            ReadOnly="True" />
                                    </dxdo:LayoutPanel>
                                </dxdo:LayoutGroup>
                            </dxdo:DockLayoutManager>
                        </Grid>
                    </dxdo:LayoutPanel>

                </dxdo:LayoutGroup>
            </dxdo:DockLayoutManager>
        </Grid>
    </Grid>
</UserControl>