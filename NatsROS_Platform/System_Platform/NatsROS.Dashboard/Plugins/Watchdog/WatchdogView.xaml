<UserControl
    x:Class="NatsROS.Dashboard.Plugins.Watchdog.WatchdogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
    Background="#1E1E1E">

    <Grid Margin="10">
        <dxlc:LayoutGroup Header="🛡️ 全网微服务健康状态 (Live APM Heartbeats)" View="GroupBox">
            <dxg:GridControl x:Name="GridApm" AutoGenerateColumns="None">
                <dxg:GridControl.View>
                    <dxg:TableView
                        AllowEditing="False"
                        AlternateRowBackground="#2D2D30"
                        NavigationStyle="Row"
                        RowMinHeight="40"
                        ShowGroupPanel="False" />
                </dxg:GridControl.View>

                <dxg:GridColumn
                    Width="200"
                    FieldName="NodeName"
                    Header="微服务名称 (Node)">
                    <dxg:GridColumn.CellStyle>
                        <!--  指定 TargetType 并添加加粗属性  -->
                        <Style TargetType="dxg:LightweightCellEditor">
                            <Setter Property="TextBlock.FontWeight" Value="Bold" />
                        </Style>
                    </dxg:GridColumn.CellStyle>


                </dxg:GridColumn>

                <dxg:GridColumn
                    Width="120"
                    FieldName="StateStr"
                    Header="生命周期" />

                <dxg:GridColumn
                    Width="200"
                    FieldName="CpuUsagePercent"
                    Header="CPU 占用率">
                    <dxg:GridColumn.CellTemplate>
                        <DataTemplate>
                            <!--  CPU 占用率柱状图  -->
                            <dxe:ProgressBarEdit
                                Height="25"
                                Margin="5"
                                ContentDisplayMode="Value"
                                DisplayFormatString="{}{0:F2} %"
                                Maximum="100"
                                Minimum="0"
                                Value="{Binding Value}">
                                <dxe:ProgressBarEdit.Style>
                                    <Style TargetType="dxe:ProgressBarEdit">
                                        <Setter Property="Foreground" Value="#FF4CAF50" />
                                        <!--  默认绿色  -->
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Value, Converter={dxmvvm:NumericToBooleanConverter}}" Value="True">
                                                <!--  这里您可以根据需要扩展 Converter 变色，Demo 中简化展示  -->
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </dxe:ProgressBarEdit.Style>
                            </dxe:ProgressBarEdit>
                        </DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>

                <dxg:GridColumn
                    Width="120"
                    FieldName="MemoryWorkingSetMb"
                    Header="内存占用 (RAM)">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings DisplayFormat="{}{0:F1} MB" />
                    </dxg:GridColumn.EditSettings>
                    <dxg:GridColumn.CellStyle>
                        <Style TargetType="dxg:LightweightCellEditor">
                            <Setter Property="Foreground" Value="Orange" />
                        </Style>
                    </dxg:GridColumn.CellStyle>
                </dxg:GridColumn>

                <dxg:GridColumn
                    Width="100"
                    FieldName="ThreadCount"
                    Header="存活线程">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings />
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>

                <dxg:GridColumn
                    Width="150"
                    FieldName="UptimeStr"
                    Header="已存活时间">
                    <dxg:GridColumn.CellStyle>
                        <Style TargetType="dxg:LightweightCellEditor">
                            <Setter Property="Foreground" Value="DarkGray" />
                        </Style>
                    </dxg:GridColumn.CellStyle>
                </dxg:GridColumn>
            </dxg:GridControl>
        </dxlc:LayoutGroup>
    </Grid>
</UserControl>