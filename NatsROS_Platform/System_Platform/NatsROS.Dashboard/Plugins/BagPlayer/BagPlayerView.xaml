<UserControl
    x:Class="NatsROS.Dashboard.Plugins.BagPlayer.BagPlayerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
    xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  顶层统一工具栏 (BarManager)  -->
        <dxb:BarManager Grid.Row="0">
            <dxb:BarManager.Bars>
                <dxb:Bar
                    AllowCustomizationMenu="False"
                    AllowQuickCustomization="False"
                    AllowRemove="False"
                    BorderThickness="5,5,5,0"
                    Caption="黑匣子操作工具栏"
                    CornerRadius="5,5,5,5"
                    GlyphSize="Large"
                    ShowDragWidget="False"
                    ShowSizeGrip="False">
                    <dxb:Bar.ItemLinks>
                        <!--  嗅探与录制组  -->
                        <dxb:BarButtonItemLink BarItemName="BtnRefreshTopics" />
                        <dxb:BarButtonItemLink BarItemName="BtnToggleRecord" />

                        <dxb:BarItemLinkSeparator />

                        <!--  加载与回放组  -->
                        <dxb:BarButtonItemLink BarItemName="BtnLoadBag" />
                        <dxb:BarButtonItemLink BarItemName="BtnPlayBag" />
                        <dxb:BarButtonItemLink BarItemName="BtnPauseBag" />
                    </dxb:Bar.ItemLinks>
                </dxb:Bar>
            </dxb:BarManager.Bars>

            <dxb:BarManager.Items>
                <!--  录制操作  -->
                <dxb:BarButtonItem
                    x:Name="BtnRefreshTopics"
                    BarItemDisplayMode="ContentAndGlyph"
                    Content="预扫描网络话题 (Sniff)"
                    Glyph="{dx:DXImage 'SvgImages/Icon Builder/Actions_Refresh.svg'}"
                    ItemClick="BtnRefreshTopics_Click" />
                <dxb:BarButtonItem
                    x:Name="BtnToggleRecord"
                    BarItemDisplayMode="ContentAndGlyph"
                    Content="⏺ 开始录制 (Record)"
                    Foreground="DarkRed"
                    Glyph="{dx:DXImage 'SvgImages/Media/Record.svg'}"
                    ItemClick="BtnToggleRecord_Click" />

                <!--  回放操作  -->
                <dxb:BarButtonItem
                    x:Name="BtnLoadBag"
                    BarItemDisplayMode="ContentAndGlyph"
                    Content="📂 加载并解析 Bag"
                    Glyph="{dx:DXImage 'SvgImages/Actions/Open.svg'}"
                    ItemClick="BtnLoadBag_Click" />
                <dxb:BarButtonItem
                    x:Name="BtnPlayBag"
                    BarItemDisplayMode="ContentAndGlyph"
                    Content="▶️ 播放 (Play)"
                    Foreground="DarkGreen"
                    Glyph="{dx:DXImage 'SvgImages/Media/Play.svg'}"
                    IsEnabled="False"
                    ItemClick="BtnPlayBag_Click" />
                <dxb:BarButtonItem
                    x:Name="BtnPauseBag"
                    BarItemDisplayMode="ContentAndGlyph"
                    Content="⏸ 暂停 (Pause)"
                    Glyph="{dx:DXImage 'SvgImages/Media/Pause.svg'}"
                    IsEnabled="False"
                    ItemClick="BtnPauseBag_Click" />
            </dxb:BarManager.Items>
        </dxb:BarManager>

        <!--  全局统一 DockLayoutManager 布局  -->
        <Grid Grid.Row="1" Margin="4">
            <dxdo:DockLayoutManager>
                <dxdo:LayoutGroup Orientation="Horizontal">

                    <!--  1. 左侧：录制面板 (Record)  -->
                    <dxdo:LayoutPanel
                        AllowClose="False"
                        Caption="⏺ 数据录制引擎 (Bag Recorder)"
                        ItemWidth="*"
                        ShowCloseButton="False"
                        ShowPinButton="False">
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <dxlc:LayoutControl
                                Grid.Row="0"
                                Margin="0,0,0,5"
                                Padding="0">
                                <dxlc:LayoutGroup Orientation="Horizontal">
                                    <dxlc:LayoutItem Width="320" Label="保存路径:">
                                        <dxe:TextEdit
                                            x:Name="TxtBagSavePath"
                                            IsReadOnly="True"
                                            Text="C:\temp\natsros_record.bag" />
                                    </dxlc:LayoutItem>
                                    <Label
                                        x:Name="LblRecordStats"
                                        Margin="15,0,0,0"
                                        VerticalAlignment="Center"
                                        Content="已录制: 0 条报文 | 大小: 0 MB"
                                        FontWeight="Bold"
                                        Foreground="Gray" />
                                </dxlc:LayoutGroup>
                            </dxlc:LayoutControl>

                            <dxg:GridControl
                                x:Name="GridRecordTopics"
                                Grid.Row="1"
                                AutoGenerateColumns="None">
                                <dxg:GridControl.View>
                                    <dxg:TableView
                                        AllowEditing="True"
                                        EnableImmediatePosting="True"
                                        NavigationStyle="Cell"
                                        ShowGroupPanel="False" />
                                </dxg:GridControl.View>
                                <dxg:GridColumn
                                    Width="80"
                                    AllowEditing="True"
                                    FieldName="IsRecordEnabled"
                                    Header="录制(Record)">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:CheckEditSettings />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn
                                    Width="250"
                                    AllowEditing="False"
                                    FieldName="TopicName"
                                    Header="网络中捕获的话题" />
                                <dxg:GridColumn
                                    Width="*"
                                    AllowEditing="False"
                                    FieldName="TopicType"
                                    Header="消息类型 (Type)">
                                    <dxg:GridColumn.CellStyle>
                                        <Style TargetType="dxg:LightweightCellEditor">
                                            <Setter Property="Foreground" Value="#007ACC" />
                                        </Style>
                                    </dxg:GridColumn.CellStyle>
                                </dxg:GridColumn>
                                <dxg:GridColumn
                                    Width="150"
                                    AllowEditing="False"
                                    FieldName="RecordedCount"
                                    Header="已录制帧数" />
                            </dxg:GridControl>
                        </Grid>
                    </dxdo:LayoutPanel>

                    <!--  2. 右侧：回放面板 (Replay)  -->
                    <dxdo:LayoutPanel
                        AllowClose="False"
                        Caption="▶️ 现场重播引擎 (Advanced Bag Player)"
                        ItemWidth="*"
                        ShowCloseButton="False"
                        ShowPinButton="False">
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <dxlc:LayoutControl
                                Grid.Row="0"
                                Margin="0,0,0,10"
                                Padding="0">
                                <dxlc:LayoutGroup Orientation="Horizontal">
                                    <dxlc:LayoutItem Width="450" Label="加载文件:">
                                        <dxe:TextEdit x:Name="TxtBagLoadPath" IsReadOnly="True" />
                                    </dxlc:LayoutItem>
                                    <dxlc:LayoutItem
                                        Width="100"
                                        Margin="10,0,0,0"
                                        Label="倍速:">
                                        <dxe:ComboBoxEdit
                                            x:Name="CboPlaySpeed"
                                            IsTextEditable="False"
                                            SelectedIndex="1">
                                            <dxe:ComboBoxEditItem Content="0.5x" />
                                            <dxe:ComboBoxEditItem Content="1.0x" />
                                            <dxe:ComboBoxEditItem Content="2.0x" />
                                            <dxe:ComboBoxEditItem Content="5.0x" />
                                            <dxe:ComboBoxEditItem Content="Max" />
                                        </dxe:ComboBoxEdit>
                                    </dxlc:LayoutItem>
                                    <Label
                                        x:Name="LblPlayTime"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Content="00:00.0 / 00:00.0"
                                        FontWeight="Bold" />
                                </dxlc:LayoutGroup>
                            </dxlc:LayoutControl>

                            <dxe:TrackBarEdit
                                x:Name="SliderTimeline"
                                Grid.Row="1"
                                Margin="10,5,10,5"
                                EditValueChanged="SliderTimeline_EditValueChanged"
                                Maximum="100"
                                Minimum="0"
                                Value="0" />

                            <dxg:GridControl
                                x:Name="GridBagTopics"
                                Grid.Row="2"
                                AutoGenerateColumns="None">
                                <dxg:GridControl.View>
                                    <dxg:TableView
                                        AllowEditing="True"
                                        NavigationStyle="Row"
                                        ShowGroupPanel="False" />
                                </dxg:GridControl.View>
                                <dxg:GridColumn
                                    Width="60"
                                    AllowEditing="True"
                                    FieldName="IsPlayEnabled"
                                    Header="回放">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:CheckEditSettings />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn
                                    Width="*"
                                    AllowEditing="False"
                                    FieldName="TopicName"
                                    Header="Bag 内包含的话题" />
                                <dxg:GridColumn
                                    Width="*"
                                    AllowEditing="False"
                                    FieldName="TopicType"
                                    Header="消息类型 (Type)">
                                    <dxg:GridColumn.CellStyle>
                                        <Style TargetType="dxg:LightweightCellEditor">
                                            <Setter Property="Foreground" Value="#007ACC" />
                                        </Style>
                                    </dxg:GridColumn.CellStyle>
                                </dxg:GridColumn>
                                <dxg:GridColumn
                                    Width="100"
                                    AllowEditing="False"
                                    FieldName="MessageCount"
                                    Header="报文数量" />
                            </dxg:GridControl>

                            <!--  说明区域下沉到底部  -->
                            <TextBlock
                                Grid.Row="3"
                                Margin="0,10,0,0"
                                FontSize="13"
                                Foreground="Gray"
                                TextWrapping="Wrap">
                                <Run FontWeight="Bold" Foreground="#007ACC">💡 NatsROS Bag 使用指南：</Run><LineBreak />
                                1. 点击【开始录制】，系统会以纳秒级精度截获全网纯二进制流并落盘保存。<LineBreak />
                                2. 勾选需要回放的特定话题（强烈建议过滤掉 RPC 相关的请求避免重放攻击）。<LineBreak />
                                3. 点击【播放】，系统会严格按照时间轴将历史数据重新打入网络！</TextBlock>
                        </Grid>
                    </dxdo:LayoutPanel>

                </dxdo:LayoutGroup>
            </dxdo:DockLayoutManager>
        </Grid>
    </Grid>

</UserControl>