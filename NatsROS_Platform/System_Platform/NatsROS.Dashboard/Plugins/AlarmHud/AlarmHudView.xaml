<UserControl
    x:Class="NatsROS.Dashboard.Plugins.AlarmHud.AlarmHudView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
    Background="Transparent">

    <Grid Margin="15">
        <!--  悬浮阴影外框  -->
        <Border
            x:Name="HudBorder"
            Background="#FF263238"
            BorderBrush="#FF37474F"
            BorderThickness="2"
            CornerRadius="12">
            <Border.Effect>
                <!--  逼真的全局环境阴影  -->
                <DropShadowEffect
                    BlurRadius="25"
                    Direction="270"
                    Opacity="0.5"
                    ShadowDepth="8"
                    Color="Black" />
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <!--  左侧：动态图标  -->
                    <ColumnDefinition Width="*" />
                    <!--  中间：文字信息  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  右侧：静音按钮  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  右侧：ACK按钮  -->
                </Grid.ColumnDefinitions>

                <!--  左侧：动态状态图标  -->
                <dx:DXImage
                    x:Name="IconStatus"
                    Grid.Column="0"
                    Width="64"
                    Height="64"
                    Margin="0,0,20,0"
                    Source="{dx:DXImage 'SvgImages/Icon Builder/Actions_Check.svg'}">
                    <dx:DXImage.Effect>
                        <!--  利用 DropShadowEffect 模拟霓虹发光效果，BlurRadius 调大，ShadowDepth 设为 0  -->
                        <DropShadowEffect
                            x:Name="GlowEffect"
                            BlurRadius="20"
                            Opacity="0.8"
                            ShadowDepth="0"
                            Color="#4CAF50" />
                    </dx:DXImage.Effect>
                </dx:DXImage>

                <!--  中间：报警摘要  -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        x:Name="TxtTitle"
                        FontSize="26"
                        FontWeight="Black"
                        Foreground="White"
                        Text="系统运行正常" />
                    <TextBlock
                        x:Name="TxtMessage"
                        Margin="0,8,0,0"
                        FontSize="16"
                        Foreground="#B0BEC5"
                        Text="目前没有任何活动报警，设备运转良好。"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!--  右侧：静音切换按钮 (带有动态图标和文字切换)  -->
                <dx:SimpleButton
                    x:Name="BtnMuteToggle"
                    Grid.Column="2"
                    Width="140"
                    Height="50"
                    Margin="10,0,10,0"
                    Background="#FF546E7A"
                    Click="BtnMuteToggle_Click"
                    Content="🔔 开启静音"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="White" />

                <!--  右侧：确认复位按钮  -->
                <dx:SimpleButton
                    x:Name="BtnAck"
                    Grid.Column="3"
                    Width="160"
                    Height="50"
                    Margin="5,0,10,0"
                    Background="White"
                    Click="BtnAck_Click"
                    Content="确认 (ACK)"
                    FontSize="18"
                    FontWeight="Black"
                    Foreground="#D32F2F"
                    IsEnabled="False" />
            </Grid>
        </Border>
    </Grid>
</UserControl>