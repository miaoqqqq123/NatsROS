<dx:ThemedWindow
    x:Class="NatsROS.Dashboard.UI.Dialogs.PluginManagerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    Title="🧩 NatsROS 插件与模块管理器 (Plugin Manager)"
    Width="1400"
    Height="800"
    ControlBoxButtonSet="Close,MaximizeRestore"
    ResizeMode="CanResizeWithGrip"
    ShowIcon="False"
    Topmost="True"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,10"
            Foreground="Gray"
            Text="勾选需要启用的插件模块。更改将在点击应用后立即生效（保存在当前工程的 ui_manifest.json 中）。" />

        <!--  插件清单数据表  -->
        <dxg:GridControl
            x:Name="GridPlugins"
            Grid.Row="1"
            AutoGenerateColumns="None">
            <dxg:GridControl.View>
                <dxg:TableView
                    AllowEditing="True"
                    EnableImmediatePosting="True"
                    NavigationStyle="Cell"
                    SearchPanelAllowFilter="True"
                    ShowGroupPanel="False"
                    ShowSearchPanelMode="Always" />
            </dxg:GridControl.View>

            <!--  勾选列  -->
            <dxg:GridColumn
                Width="90"
                AllowEditing="True"
                FieldName="IsEnabled"
                Header="启用 (Enable)">
                <dxg:GridColumn.EditSettings>
                    <dxe:CheckEditSettings />
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>

            <!--  【新增】：高亮状态列  -->
            <dxg:GridColumn
                Width="90"
                AllowEditing="False"
                FieldName="Status"
                Header="健康状态">
                <dxg:GridColumn.CellStyle>
                    <Style TargetType="dxg:LightweightCellEditor">

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RowData.Row.Status}" Value="✅ 正常">
                                <Setter Property="Foreground" Value="#4CAF50" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding RowData.Row.Status}" Value="⚠️ 丢失">
                                <Setter Property="Foreground" Value="#FF9800" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding RowData.Row.Status}" Value="❌ 崩溃">
                                <Setter Property="Foreground" Value="#F44336" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </dxg:GridColumn.CellStyle>
            </dxg:GridColumn>

            <!--  插件名称  -->
            <dxg:GridColumn
                Width="250"
                AllowEditing="False"
                FieldName="DisplayName"
                Header="插件名称 (Name)">
                <dxg:GridColumn.CellStyle>
                    <Style TargetType="dxg:LightweightCellEditor">

                        <Setter Property="Foreground" Value="#00BCD4" />
                    </Style>
                </dxg:GridColumn.CellStyle>
            </dxg:GridColumn>

            <dxg:GridColumn
                Width="200"
                AllowEditing="False"
                FieldName="ClassName"
                Header="插件类型 (Class Type)" />

            <dxg:GridColumn
                Width="150"
                AllowEditing="False"
                FieldName="Source"
                Header="来源 (Source)" />

            <dxg:GridColumn
                Width="100"
                AllowEditing="False"
                FieldName="Version"
                Header="版本 (Version)">
                <dxg:GridColumn.CellStyle>
                    <Style TargetType="dxg:LightweightCellEditor">

                        <Setter Property="Foreground" Value="Orange" />
                    </Style>
                </dxg:GridColumn.CellStyle>
            </dxg:GridColumn>

            <dxg:GridColumn
                Width="150"
                AllowEditing="False"
                FieldName="RibbonPage"
                Header="选项卡 (Page)" />
            <dxg:GridColumn
                Width="150"
                AllowEditing="False"
                FieldName="RibbonGroup"
                Header="功能区 (Group)" />

            <dxg:GridColumn
                Width="*"
                AllowEditing="False"
                FieldName="ErrorMessage"
                Header="诊断信息 (Diagnostics)">
                <dxg:GridColumn.CellStyle>
                    <Style TargetType="dxg:LightweightCellEditor">

                        <Setter Property="Foreground" Value="Gray" />
                    </Style>
                </dxg:GridColumn.CellStyle>
            </dxg:GridColumn>

        </dxg:GridControl>

        <!--  底部控制按钮  -->
        <StackPanel
            Grid.Row="2"
            Margin="0,10,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <dx:SimpleButton
                Width="120"
                Height="30"
                Background="#FF2E7D32"
                Click="BtnApply_Click"
                Content="✅ 保存并应用"
                FontWeight="Bold"
                Foreground="White" />
            <dx:SimpleButton
                Width="100"
                Height="30"
                Margin="10,0,0,0"
                Click="BtnCancel_Click"
                Content="❌ 取 消" />
        </StackPanel>
    </Grid>
</dx:ThemedWindow>