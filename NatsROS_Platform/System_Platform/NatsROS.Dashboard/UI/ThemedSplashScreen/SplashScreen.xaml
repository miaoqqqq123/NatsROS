<dx:SplashScreenWindow
    x:Class="NatsROS.Dashboard.UI.ThemedSplashScreen.SplashScreen"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
    xmlns:dxt="http://schemas.devexpress.com/winfx/2008/xaml/core/themekeys"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="400"
    MinHeight="100"
    d:DataContext="{x:Static dxmvvm:DXSplashScreenViewModel.DesignTimeData}"
    AllowDrag="False"
    AllowTheming="True"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Height="100" Style="{DynamicResource ResourceKey={dxt:SplashScreenThemeKey ResourceKey=TopRegionStyle}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <dx:DXImage
                    Grid.Row="0"
                    Margin="10,10,10,10"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Source="/UI/ThemedSplashScreen/ats256x256.ico"
                    Stretch="Uniform"
                    Style="{DynamicResource ResourceKey={dxt:SplashScreenThemeKey ResourceKey=LogoImageStyle}}" />

                <StackPanel
                    Grid.Row="0"
                    Grid.Column="1"
                    VerticalAlignment="Center">
                    <TextBlock
                        FontWeight="Bold"
                        Style="{DynamicResource ResourceKey={dxt:SplashScreenThemeKey ResourceKey=TitleTextBoxStyle}}"
                        Text="{Binding Title}"
                        TextWrapping="WrapWithOverflow" />
                    <TextBlock Style="{DynamicResource ResourceKey={dxt:SplashScreenThemeKey ResourceKey=SubTitleTextBoxStyle}}" Text="{Binding Subtitle}" />
                </StackPanel>
            </Grid>

        </Border>
        <Border
            Grid.Row="1"
            Height="130"
            Style="{DynamicResource ResourceKey={dxt:SplashScreenThemeKey ResourceKey=BottomRegionStyle}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="40" />
                </Grid.RowDefinitions>
                <StackPanel Margin="20,0,20,0" VerticalAlignment="Center">
                    <TextBlock
                        Style="{DynamicResource ResourceKey={dxt:SplashScreenThemeKey ResourceKey=StatusTextBoxStyle}}"
                        Text="{Binding Status}"
                        TextWrapping="WrapWithOverflow" />
                    <ProgressBar
                        IsIndeterminate="{Binding IsIndeterminate}"
                        Style="{DynamicResource ResourceKey={dxt:SplashScreenThemeKey ResourceKey=ProgressBarStyle}}"
                        Value="{Binding Progress}" />
                </StackPanel>
                <TextBlock
                    Grid.Row="1"
                    VerticalAlignment="Bottom"
                    Style="{DynamicResource ResourceKey={dxt:SplashScreenThemeKey ResourceKey=CopyrightTextBoxStyle}}"
                    Text="{Binding Copyright}"
                    TextWrapping="WrapWithOverflow" />
            </Grid>
        </Border>
    </Grid>
</dx:SplashScreenWindow>
