<dx:ThemedWindow
    x:Class="NatsROS.Dashboard.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
    xmlns:dxd="http://schemas.devexpress.com/winfx/2008/xaml/docking"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
    xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon"
    Title="{DynamicResource MainTitle}"
    Width="1200"
    Height="800"
    Closing="Window_Closing"
    Loaded="Window_Loaded"
    WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  1. 顶部：Ribbon 菜单  -->
        <dxr:RibbonControl
            x:Name="MainRibbon"
            Grid.Row="0"
            RibbonStyle="Office2019"
            ShowApplicationButton="False">

            <dxr:RibbonControl.PageHeaderItems>
                <dxb:BarSubItem
                    x:Name="MenuUserProfile"
                    IsVisible="True"
                    RibbonStyle="All">

                    <!--  【UI 升维魔法】：通过 ContentTemplate 强行放大字体，并增加徽章背景！  -->
                    <dxb:BarSubItem.ContentTemplate>
                        <DataTemplate>
                            <!--  加一个半透明的底色和圆角，看起来像个高级按钮  -->
                            <Border
                                Padding="10,4"
                                Background="#20FFFFFF"
                                CornerRadius="4">
                                <StackPanel Orientation="Horizontal">
                                    <dx:DXImage
                                        Width="20"
                                        Height="20"
                                        Margin="0,0,5,0"
                                        Source="{dx:DXImage 'SvgImages/Business Objects/BO_User.svg'}" />
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Foreground="#00BCD4"
                                        Text="{Binding}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </dxb:BarSubItem.ContentTemplate>

                    <!--  下拉菜单：展示角色信息 (纯文本，不可点击)  -->
                    <dxb:BarStaticItem x:Name="MenuRoleInfo" Content="所属角色: --" />

                    <!--  分割线  -->
                    <dxb:BarItemLinkSeparator />

                    <!--  下拉菜单：切换账号  -->
                    <dxb:BarButtonItem
                        x:Name="MenuSwitchUser"
                        Content="切换账号"
                        Glyph="{dx:DXImage 'SvgImages/Icon Builder/Actions_User.svg'}"
                        ItemClick="BtnSwitchUser_ItemClick" />
                </dxb:BarSubItem>


            </dxr:RibbonControl.PageHeaderItems>

            <!--  【修改1】：关闭了 ShowApplicationButton，彻底移除 File 后台菜单  -->
            <dxr:RibbonDefaultPageCategory x:Name="RibbonCategory">

                <!--  【修改2】：固定内置的常驻主页 (Home)，不受配置清单影响  -->
                <dxr:RibbonPage Caption="主页 (Home)">

                    <!--  【新增】：工程与系统管理分组  -->
                    <dxr:RibbonPageGroup Caption="工程与系统 (Project &amp; System)">
                        <dxb:BarButtonItem
                            x:Name="BtnImportExternalProject"
                            Content="导入外部工程包"
                            ItemClick="BtnImportExternalProject_ItemClick"
                            LargeGlyph="{dx:DXImage 'SvgImages/Actions/Open.svg'}"
                            RibbonStyle="Large" />

                        <dxb:BarButtonItem
                            x:Name="BtnExportProject"
                            Content="导出当前工程包"
                            ItemClick="BtnExportProject_ItemClick"
                            LargeGlyph="{dx:DXImage 'SvgImages/Export/ExportFile.svg'}"
                            RibbonStyle="Large" />

                        <dxb:BarButtonItem
                            x:Name="BtnPluginManager"
                            Content="插件管理器"
                            ItemClick="BtnPluginManager_ItemClick"
                            LargeGlyph="{dx:DXImage 'SvgImages/Dashboards/GroupTooltips.svg'}"
                            RibbonStyle="Large" />
                    </dxr:RibbonPageGroup>

                    <!--  原有的视图控制分组  -->
                    <dxr:RibbonPageGroup Caption="视图控制 (View Control)">
                        <dxb:BarButtonItem
                            x:Name="BtnSaveLayout"
                            Content="{DynamicResource SaveLayoutBtn}"
                            ItemClick="BtnSaveLayout_ItemClick"
                            LargeGlyph="{dx:DXImage 'SvgImages/Save/Save.svg'}"
                            RibbonStyle="Large" />

                        <dxb:BarButtonItem
                            x:Name="BtnSwitchLang"
                            Content="{DynamicResource LangSwitchBtn}"
                            ItemClick="BtnSwitchLang_ItemClick"
                            LargeGlyph="{dx:DXImage 'SvgImages/Icon Builder/Travel_Globe.svg'}"
                            RibbonStyle="Large" />

                        <dxb:BarButtonItem
                            x:Name="BtnClearLog"
                            Content="清空日志视图"
                            ItemClick="BtnClearLog_ItemClick"
                            LargeGlyph="{dx:DXImage 'SvgImages/Icon Builder/Actions_Clear.svg'}"
                            RibbonStyle="Large" />

                        <dxb:BarButtonItem
                            x:Name="BtnRestoreLayout"
                            Content="{DynamicResource ResetLayoutBtn}"
                            ItemClick="BtnRestoreLayout_ItemClick"
                            LargeGlyph="{dx:DXImage 'SvgImages/Dashboards/Layout.svg'}"
                            RibbonStyle="Large" />
                    </dxr:RibbonPageGroup>

                    <!--  原有的主题与皮肤分组  -->
                    <dxr:RibbonPageGroup Caption="主题与皮肤 (Themes)">
                        <dxr:RibbonGalleryBarItem x:Name="ThemeGallery" Content="切换皮肤 (Themes)">
                            <dxmvvm:Interaction.Behaviors>
                                <dxr:RibbonGalleryItemThemeSelectorBehavior />
                            </dxmvvm:Interaction.Behaviors>
                        </dxr:RibbonGalleryBarItem>
                    </dxr:RibbonPageGroup>

                </dxr:RibbonPage>

                <!--  动态插件生成的 RibbonPage 会自动挂载到这个 Category 的后面  -->
            </dxr:RibbonDefaultPageCategory>

        </dxr:RibbonControl>


        <!--  2. 中间：高级停靠管理器  -->
        <dxd:DockLayoutManager
            x:Name="DockManager"
            Grid.Row="1"
            FloatingMode="Desktop">
            <dxd:LayoutGroup Orientation="Vertical">

                <!--  上半部分：插件工作区 (MDI)  -->
                <dxd:DocumentGroup
                    x:Name="MdiContainer"
                    ClosePageButtonShowMode="InActiveTabPageHeader"
                    DestroyOnClosingChildren="False"
                    ItemHeight="3*">

                    <!--  自适应主题的欢迎大屏  -->
                    <dxd:DocumentPanel
                        x:Name="PanelWelcome"
                        AllowDrag="False"
                        AllowFloat="False"
                        Caption="欢迎使用 (Welcome)"
                        ShowCloseButton="False">
                        <Grid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <dx:DXImage
                                    Width="150"
                                    Height="150"
                                    Margin="0,0,0,20"
                                    Source="{dx:DXImage 'SvgImages/Dashboards/Cards.svg'}" />

                                <TextBlock
                                    FontSize="48"
                                    FontWeight="Bold"
                                    Opacity="0.8"
                                    Text="{DynamicResource WelcomeMsg}"
                                    TextAlignment="Center" />
                                <TextBlock
                                    Margin="0,10,0,30"
                                    FontSize="20"
                                    Foreground="#007ACC"
                                    Text="{DynamicResource SubWelcomeMsg}"
                                    TextAlignment="Center" />

                                <dxlc:LayoutGroup
                                    Width="600"
                                    Padding="15"
                                    Header="💡 快速开始指南"
                                    Orientation="Vertical"
                                    View="GroupBox">
                                    <TextBlock
                                        Margin="0,5"
                                        FontSize="14"
                                        Opacity="0.7"
                                        Text="1. 确保后台已启动 nats-server (推荐附加 -js 参数以启用高级流特性)。" />
                                    <TextBlock
                                        Margin="0,5"
                                        FontSize="14"
                                        Opacity="0.7"
                                        Text="2. 确保包含节点的 DLL 文件存放在 Plugins 目录下以便动态注入。" />
                                    <TextBlock
                                        Margin="0,5"
                                        FontSize="14"
                                        Opacity="0.7"
                                        Text="3. 点击上方 Ribbon 菜单栏中的插件按钮，即可开启对应的监控与调试工具。" />
                                    <TextBlock
                                        Margin="0,5"
                                        FontSize="14"
                                        Opacity="0.7"
                                        Text="4. 所有窗口均支持自由拖拽停靠，您可以按需拼装属于自己的指挥中心！" />
                                </dxlc:LayoutGroup>
                            </StackPanel>
                        </Grid>
                    </dxd:DocumentPanel>
                </dxd:DocumentGroup>

                <!--  下半部分：固定内置的全局日志面板  -->
                <dxd:LayoutPanel
                    AllowFloat="True"
                    Caption="全局遥测日志 (/rosout) [内置核心]"
                    ItemHeight="1*"
                    ShowCloseButton="False"
                    ShowPinButton="False">
                    <RichTextBox
                        x:Name="RtbLogs"
                        Background="Transparent"
                        BorderThickness="0"
                        FontFamily="Consolas"
                        FontSize="13"
                        IsReadOnly="True"
                        VerticalScrollBarVisibility="Auto">
                        <FlowDocument x:Name="LogDocument" PagePadding="5" />
                    </RichTextBox>
                </dxd:LayoutPanel>

            </dxd:LayoutGroup>
        </dxd:DockLayoutManager>

        <!--  3. 底部：全局系统状态栏  -->
        <dxb:StatusBarControl Grid.Row="2" Background="#2D2D30">
            <dxb:BarStaticItem
                x:Name="StatusConnection"
                Content="准备连接 NATS..."
                Glyph="{dx:DXImage 'SvgImages/Icon Builder/Security_Warning.svg'}" />
            <dxb:BarStaticItem
                x:Name="StatusPluginCount"
                Alignment="Default"
                Content="加载了 0 个插件" />
            <dxb:BarStaticItem
                x:Name="StatusActiveRecipe"
                Alignment="Far"
                Content="当前配方: [空载待命]"
                Foreground="Orange" />
            <dxb:BarStaticItem
                x:Name="StatusCurrentUser"
                Margin="20,0,0,0"
                Alignment="Far"
                Content="👤 用户: 未登录" />
        </dxb:StatusBarControl>

    </Grid>
</dx:ThemedWindow>